# Bomu (Bwamu, bmq) morphotactic patterns
# version 2026.11.23 — revised from beni/data/raw/bmq.txt & test.json

# macro definitions
macro   @v@             <re>.*[aoeuiɔɛãẽĩõũɛ̃ɔ̃]</re>
macro   @nasal-v@       <re>.*([ãẽĩõũɛ̃ɔ̃]|[aoeuiɔɛ]n)</re>
macro   @nonnasal-v@    <re>.*[aoeuiɔɛ]</re>
macro   @cons@          <re>.*[bcdfghjklmnprstvwyzɓɲŋ]</re>
macro   @syl@           [^aoeuiɔɛãẽĩõũɛ̃ɔ̃]*(?P<V>[aoeuiɔɛãẽĩõũɛ̃ɔ̃])(?P=V)?(n(?=([^aoeuiɔɛãẽĩõũɛ̃ɔ̃]|$)))?

# processing instructions
plan
for token:
stage 0 add parallel parse inflection
stage 0 add parallel parse common_derivation
stage 0 apply lookup
return if parsed
stage 1 add sequential parse n_v_derivation
stage 1 add parallel parse n_derivation
stage 1 add parallel parse v_derivation
stage 1 add parallel parse num_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse nonbomu
return if parsed

# --- INFLECTION (Noun Class & Plural Markers) ---
section inflection
# Plural markers attested in bmq.txt & test.json:
# -pɛɛ (human/animate plural: nupɛɛ, dapɛɛ), -nu / -bee / -be (general/class plurals: deeɓenu, sɛnnu, vesirobe, werobe)
# -robe (agent/nominal plural: toosɛrobe), -ɓe (human plural)
pattern :n/adj/prn/n.prop: [ {|pɛɛ}:: ] | :n/adj/prn/n.prop: [:n/adj/prn/n.prop: :mrph:PL.HUM]
pattern :n/adj/prn/n.prop: [ {|ɓe}:: ] | :n/adj/prn/n.prop: [:n/adj/prn/n.prop: :mrph:PL.HUM]
pattern :n/adj/prn/n.prop: [ {|nu}:: ] | :n/adj/prn/n.prop: [:n/adj/prn/n.prop: :mrph:PL]
pattern :n/adj/prn/n.prop: [ {|bee}:: ] | :n/adj/prn/n.prop: [:n/adj/prn/n.prop: :mrph:PL]
pattern :n/adj/prn/n.prop: [ {|be}:: ] | :n/adj/prn/n.prop: [:n/adj/prn/n.prop: :mrph:PL]
pattern :n/adj/prn/n.prop: [ {|robe}:: ] | :n/adj/prn/n.prop: [:n/adj/prn/n.prop: :mrph:PL]

# Singular / class & focus suffixes (-yo, -siyo, -le, -wa)
pattern :n: [ {|siyo}:: ] | :n: [:n: :mrph:SG.CL]
pattern :n: [ {|yo}:: ] | :n: [:n: :mrph:SG.CL]
pattern :n/v: [ {|le}:: ] | :n/v: [:n/v: :mrph:DEF]

# --- COMMON DERIVATION ---
section common_derivation
# Abstract nouns: -yamu / -mu / -ya (e.g., huwarayamu, yiramu, banmu, dediya)
pattern :n/adj/v: [ {|yamu}:: ] | :n: [:n/adj/v: :mrph:ABSTR]
pattern :n/adj/v: [ {|mu}:: ] | :n: [:n/adj/v: :mrph:ABSTR]
pattern :n/adj/v: [ {|ya}:: ] | :n: [:n/adj/v: :mrph:ABSTR]
# Diminutive / Augmentative
pattern :n/adj: [ {|ba}:: ] | :n/adj: [:n/adj: :mrph:AUGM]
pattern :n/adj: [ {|nin}:: ] | :n/adj: [:n/adj: :mrph:DIM]

# --- RELATIONAL / LOCATIVE CLITICS ---
section n_v_derivation
# Locative / relational suffixes (-la, -na, -ra)
pattern :n/n.prop: [ {@nasal-v@|na}:: ] | :n/n.prop: [:n/n.prop: :mrph:LOC]
pattern :n/n.prop: [ {@nonnasal-v@|la}:: ] | :n/n.prop: [:n/n.prop: :mrph:LOC]
pattern :n/n.prop: [ {|ra}:: ] | :n/n.prop: [:n/n.prop: :mrph:LOC]

# --- NOMINAL DERIVATION ---
section n_derivation
# -ma COM / -ntan PRIV / -re / -ɛnɛ
pattern :n: [ {|ma}:: ] | :n: [ :n: :mrph:COM]
pattern :adj/n: [ {|ntan}:: ] | :adj/n: [ :n: :mrph:PRIV]
pattern :n: [ {|re}:: ] | :n: [ :n/v: :mrph:NMLZ]

# --- VERBAL DERIVATION & ASPECT ---
section v_derivation
# Verbal extensions & TAM (-ni, -na, -ra, -wa, -wan, -nya)
pattern :v: [ {|ni}:: ] | :v: [ :v: :mrph:TR]
pattern :v: [ {|na}:: ] | :v: [ :v: :mrph:PFV]
pattern :v: [ {|ra}:: ] | :v: [ :v: :mrph:PFV.ALT]
pattern :v: [ {|wa}:: ] | :v: [ :v: :mrph:IPFV]
pattern :v: [ {|wan}:: ] | :v: [ :v: :mrph:PROG]
pattern :n: [ {|niya}:: ] | :n: [ :v: :mrph:NMLZ]

# --- NUMERAL DERIVATION ---
section num_derivation
pattern :num: [ {|na}:: ] | :num: [ :num: :mrph:ORD]
pattern :num: [ {|la}:: ] | :num: [ :num: :mrph:DISTR]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :num: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :num: [ :num: :num: ]
pattern :v: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :v: [ :v: :: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :: :adj: ]
pattern :num: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :num: [ :num: :: :num: ]

# --- POS COMPOSITION (Compounds & Hyphenated Forms) ---
section pos_composition
# Attested hyphenated compounds (e.g., ho-senu, sere-inso, li-wure)
pattern :n: [ :n/dtm/prn: :n: ] | :n: [ :n/dtm/prn: :n: ]
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n/v: :n: ] | :n: [ :n/v: :n: ]
pattern :n/v: [ :n: :v: ] | :n/v: [ :n: :v: ]
pattern :n: [ :n: :adj/num: ] | :n: [ :n: :adj/num: ]
pattern :n: [ :dtm: :v: ] | :n: [ :dtm: :v: ]
pattern :n: [ :n: :adj/pp/num: :n: ] | :n: [ :n: :adj/pp/num: :n: ]
pattern :n: [ :dtm/n: :v: :n: ] | :n: [ :dtm/n: :v: :n: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]
pattern :n: [ :v: yamu:mrph: ] | :n: [ :v: :mrph:ABSTR ]
pattern :n: [ :v: mu:mrph: ] | :n: [ :v: :mrph:ABSTR ]

# --- NON-BOMU FILTER (STAGE 4 = EMPR) ---
section nonbomu
# Characters outside Bomu orthography (allows a-z excl q,x + ɓ ɛ ɔ ɲ ŋ + tonal/nasal vowels & homoglyph ε/ԑ)
pattern <re>.*[qxQXçäëïöüâêîôûùàøðþ].*</re>:: | ::EMPR

# Hassaniya Arabic (mey) morphotactic patterns
# version 2026.11.23 — ground-up Semitic rewrite replacing legacy Fula copy-paste
# Covers both Mali Latin orthography (test.json, hsy jsonl) and academic transcription (mey.txt, mey dict)

# macro definitions
macro   @vow@            <re>.*[aeiouăəāīū]</re>
macro   @cons@           <re>.*[bcdfghjklmnpqrstvwxyzḍḥṣṭẓšɣɤʕ]</re>
macro   @syl@            [^aeiouăəāīū]*(?P<V>[aeiouăəāīū])(?P=V)?

# processing instructions
plan
for token:
stage 0 add parallel parse proclitics_and_articles
stage 0 add parallel parse nominal_inflection
stage 0 add parallel parse pronominal_enclitics
stage 0 apply lookup
return if parsed
stage 1 add sequential parse verbal_inflection
stage 1 add parallel parse derivational_patterns
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse nonhassaniya
return if parsed

# --- PROCLITICS & DEFINITE ARTICLE (al-, əl-, il-, l-, wo-, bi-, li-, fi-, vi-) ---
section proclitics_and_articles
# Definite article proclitics (attached or hyphenated: əlhuquug, əlwajibat, albarleman, əl-mudiir, il-kull)
pattern :n/adj: [ {əl|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {al|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {il|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {әl|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {əl-|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {әl-|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {al-|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {il-|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]
pattern :n/adj: [ {l-|}:: ] | :n/adj: [ :mrph:DEF :n/adj: ]

# Prepositional & conjunction proclitics (bi-, li-, fi-, vi-, wo-, w-)
pattern :n/adj/prn: [ {bi-|}:: ] | :n/adj/prn: [ :mrph:PREP.INSTR :n/adj/prn: ]
pattern :n/adj/prn: [ {li-|}:: ] | :n/adj/prn: [ :mrph:PREP.DAT :n/adj/prn: ]
pattern :n/adj/prn: [ {fi-|}:: ] | :n/adj/prn: [ :mrph:PREP.LOC :n/adj/prn: ]
pattern :n/adj/prn: [ {vi-|}:: ] | :n/adj/prn: [ :mrph:PREP.LOC :n/adj/prn: ]
pattern :n/adj/prn/v: [ {wo-|}:: ] | :n/adj/prn/v: [ :mrph:CONJ :n/adj/prn/v: ]

# --- NOMINAL INFLECTION (Plurals, Feminine, Nisba) ---
section nominal_inflection
# Sound feminine plural (-aat, -at), sound masculine plural (-iin, -in)
pattern :n/adj: [ {|aat}:: ] | :n/adj: [ :n/adj: :mrph:PL.F ]
pattern :n/adj: [ {|āt}:: ] | :n/adj: [ :n/adj: :mrph:PL.F ]
pattern :n/adj: [ {|iin}:: ] | :n/adj: [ :n/adj: :mrph:PL.M ]
pattern :n/adj: [ {|īn}:: ] | :n/adj: [ :n/adj: :mrph:PL.M ]
# Nisba / relational adjective & abstract noun (-iyya, -iya, -iyye, -yya, -iye)
pattern :n/adj: [ {|iyya}:: ] | :n/adj: [ :n/adj: :mrph:NISBA ]
pattern :n/adj: [ {|iyye}:: ] | :n/adj: [ :n/adj: :mrph:NISBA ]
pattern :n/adj: [ {|iya}:: ] | :n/adj: [ :n/adj: :mrph:NISBA ]
pattern :n/adj: [ {|iye}:: ] | :n/adj: [ :n/adj: :mrph:NISBA ]
pattern :n/adj: [ {|yya}:: ] | :n/adj: [ :n/adj: :mrph:NISBA ]
# Dual (-eyn, -ayn)
pattern :n/adj: [ {|eyn}:: ] | :n/adj: [ :n/adj: :mrph:DU ]
pattern :n/adj: [ {|ayn}:: ] | :n/adj: [ :n/adj: :mrph:DU ]

# --- PRONOMINAL ENCLITICS ---
section pronominal_enclitics
# Attached & hyphenated object/possessive enclitics (-he, -ḥe, -ha, -hum, -kum, -na, -ne, -i, -u)
pattern :n/v/prep: [ {|hum}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.3PL ]
pattern :n/v/prep: [ {|kum}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.2PL ]
pattern :n/v/prep: [ {|ḥe}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.3FSG ]
pattern :n/v/prep: [ {|he}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.3FSG ]
pattern :n/v/prep: [ {|-he}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.3FSG ]
pattern :n/v/prep: [ {|-ḥe}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.3FSG ]
pattern :n/v/prep: [ {|-hum}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.3PL ]
pattern :n/v/prep: [ {|-na}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.1PL ]
pattern :n/v/prep: [ {|-i}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.1SG ]
pattern :n/v/prep: [ {|-u}:: ] | :n/v/prep: [ :n/v/prep: :mrph:POSS.3MSG ]

# --- VERBAL INFLECTION (Semitic Imperfective Prefixes & Perfective Suffixes) ---
section verbal_inflection
# Imperfective subject prefixes (yə-, tə-, nə-, yi-, ti-, ni-)
pattern :v: [ {yə|}:: ] | :v: [ :mrph:IPFV.3MSG :v: ]
pattern :v: [ {tə|}:: ] | :v: [ :mrph:IPFV.2SG.3FSG :v: ]
pattern :v: [ {nə|}:: ] | :v: [ :mrph:IPFV.1PL :v: ]
pattern :v: [ {yi|}:: ] | :v: [ :mrph:IPFV.3MSG :v: ]
pattern :v: [ {ti|}:: ] | :v: [ :mrph:IPFV.2SG.3FSG :v: ]
pattern :v: [ {ni|}:: ] | :v: [ :mrph:IPFV.1PL :v: ]
# Perfective agreement suffixes (-et, -ət, -tu, -na)
pattern :v: [ {|et}:: ] | :v: [ :v: :mrph:PFV.3FSG ]
pattern :v: [ {|ət}:: ] | :v: [ :v: :mrph:PFV.3FSG ]
pattern :v: [ {|tu}:: ] | :v: [ :v: :mrph:PFV.2PL ]
pattern :v: [ {|na}:: ] | :v: [ :v: :mrph:PFV.1PL ]

# --- DERIVATIONAL PATTERNS (Form X st-, Participle mu-/mət-) ---
section derivational_patterns
pattern :v/n: [ {st|}:: ] | :v/n: [ :mrph:CAUS.REFL :v/n: ]
pattern :n/adj/ptcp: [ {mu|}:: ] | :ptcp: [ :mrph:PTCP :v/n: ]
pattern :n/adj/ptcp: [ {mət|}:: ] | :ptcp: [ :mrph:PASS.PTCP :v/n: ]
pattern :n/adj: [ {|aan}:: ] | :adj: [ :v/n: :mrph:INTNS ]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :n: [ :n: :: :n: ]

# --- POS COMPOSITION (Construct State / Idafa Compounds) ---
section pos_composition
pattern :n: [ :n: :n: ] | :n: [ :n: :n: ]
pattern :n: [ :n: :adj: ] | :n: [ :n: :adj: ]
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n: :n.prop: ] | :n: [ :n: :n.prop: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]

# --- NON-HASSANIYA FILTER (STAGE 4 = EMPR) ---
section nonhassaniya
# Reject characters absent from Hassaniya Latin/academic orthographies (allows ʕ ḍ ḥ ṣ ṭ ẓ ɣ ɤ š ə ә ă ā ī ū)
pattern <re>.*[ɓɗƴɲŋɔɛƔƎʐʑʂʈɖçœæ].*</re>:: | ::EMPR

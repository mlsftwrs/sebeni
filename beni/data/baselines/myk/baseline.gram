# Mamara Senufo (myk) morphotactic patterns
# version 2026.11.23 — revised from beni/data/raw/myk.txt & test.json
# Note: unconstrained single-letter suffixes (-a, -i) removed to eliminate 50.8% phantom splits.

# macro definitions
macro   @vow@            <re>.*[aeiouɛɔãẽĩõũ]</re>
macro   @cons@           <re>.*[bcdfghjklmnɲŋprsʃtvwyz]</re>
macro   @syl@            [^aeiouɛɔ]*(?P<V>[aeiouɛɔ])(?P=V)?([^aeiouɛɔ]+(?=([^aeiouɛɔ]|$)))?

# processing instructions
plan
for token:
stage 0 add parallel parse noun_inflection
stage 0 add parallel parse verb_inflection
stage 0 apply lookup
return if parsed
stage 1 add sequential parse verbal_derivation
stage 1 add parallel parse nominal_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse loanwords
return if parsed

# --- NOUN INFLECTION (Senufo Noun Class Definite & Plural Suffixes) ---
section noun_inflection
# Class 1/2 (Human/Animate): -wu/-wuu/-wi (sg), -pii/-pi/-pyii/-bii/-bi (pl)
pattern :n/adj: [ {|wuu}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL1 ]
pattern :n/adj: [ {|wu}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL1 ]
pattern :n/adj: [ {|wi}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL1 ]
pattern :n/adj: [ {|pyii}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL2 ]
pattern :n/adj: [ {|pii}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL2 ]
pattern :n/adj: [ {|bii}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL2 ]
pattern :n/adj: [ {|bi}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL2 ]
pattern :n/adj: [ {|pi}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL2 ]

# Class 3/4 (ki/yi): -kii/-ki/-gii/-gi (sg), -yii/-yi/-yɛ (pl)
pattern :n/adj: [ {|kii}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|gii}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|ki}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|gi}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|yii}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL4 ]
pattern :n/adj: [ {|yi}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL4 ]
pattern :n/adj: [ {|yɛ}:: ] | :n/adj: [ :n/adj: :mrph:PL.DIM ]

# Class 5/6 (li/ke): -lii/-li/-ri (sg), -kɛ/-gɛ/-ke/-ge/-kɔ/-gɔ/-gbɔ/-gbɔhɔ (pl/cl)
pattern :n/adj: [ {|lii}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL5 ]
pattern :n/adj: [ {|li}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL5 ]
pattern :n/adj: [ {|ri}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL5 ]
pattern :n/adj: [ {|gbɔhɔ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]
pattern :n/adj: [ {|gbɔ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]
pattern :n/adj: [ {|kɛ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]
pattern :n/adj: [ {|gɛ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]
pattern :n/adj: [ {|ke}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]
pattern :n/adj: [ {|ge}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]
pattern :n/adj: [ {|kɔ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]
pattern :n/adj: [ {|gɔ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL6 ]

# Class 7/8 (ti/ma): -tii/-ti/-di (sg), -mɛɛ/-mɛ/-mɔ/-ma (mass/liq), -ŋɛ/-ŋɔ/-rɛ/-lɛ/-nɛ
pattern :n/adj: [ {|tii}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL7 ]
pattern :n/adj: [ {|ti}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL7 ]
pattern :n/adj: [ {|di}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL7 ]
pattern :n/adj: [ {|mɛɛ}:: ] | :n/adj: [ :n/adj: :mrph:MASS.LIQ ]
pattern :n/adj: [ {|mɛ}:: ] | :n/adj: [ :n/adj: :mrph:MASS.LIQ ]
pattern :n/adj: [ {|mɔ}:: ] | :n/adj: [ :n/adj: :mrph:MASS.LIQ ]
pattern :n/adj: [ {|ŋɛ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL ]
pattern :n/adj: [ {|ŋɔ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL ]
pattern :n/adj: [ {|rɛ}:: ] | :n/adj: [ :n/adj: :mrph:PL.INAN ]
pattern :n/adj: [ {|lɛ}:: ] | :n/adj: [ :n/adj: :mrph:PL.INAN ]

# Plural vowel lengthening / suffixes (-uu, -ee, -aa, -ŋaa, -oo)
pattern :n: [ {|uu}:: ] | :n: [ :n: :mrph:PL ]
pattern :n: [ {|ee}:: ] | :n: [ :n: :mrph:PL.HUM ]
pattern :n: [ {|aa}:: ] | :n: [ :n: :mrph:PL.INAN ]
pattern :n: [ {|ŋaa}:: ] | :n: [ :n: :mrph:PL.INDEF ]
pattern :n: [ {|oo}:: ] | :n: [ :n: :mrph:DEF ]

# --- VERBAL INFLECTION (Aspect & Mood) ---
section verb_inflection
pattern :v: [ {|ni}:: ] | :v: [ :v: :mrph:IPFV ]
pattern :v: [ {|ba}:: ] | :v: [ :v: :mrph:FUT ]
pattern :v: [ {|da}:: ] | :v: [ :v: :mrph:HAB ]
pattern :v: [ {|ri}:: ] | :v: [ :v: :mrph:STAT ]
pattern :v: [ {|mɛ}:: ] | :v: [ :v: :mrph:NEG ]
pattern :v: [ {|wa}:: ] | :v: [ :v: :mrph:NEG.PFV ]
pattern :v: [ {|ya}:: ] | :v: [ :v: :mrph:NEG.IPFV ]

# --- VERBAL DERIVATION (Extensions & Participles) ---
section verbal_derivation
pattern :v: [ {|gi}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :v: [ {|gɔ}:: ] | :v: [ :v: :mrph:DIR.IN ]
pattern :v: [ {|ra}:: ] | :v: [ :v: :mrph:DIR.OUT ]
pattern :v: [ {|ŋi}:: ] | :v: [ :v: :mrph:PASS ]
pattern :v/ptcp: [ {|ŋɛ}:: ] | :ptcp: [ :v: :mrph:PTCP.PFV ]
pattern :v/ptcp: [ {|baa}:: ] | :ptcp: [ :v: :mrph:PTCP.NEG ]
# Nasal/class proclitics (na-, ni-, ka-, ta-)
pattern :n/v: [ {na-|}:: ] | :n/v: [ :mrph:LOC :n/v: ]
pattern :n/v: [ {ni-|}:: ] | :n/v: [ :mrph:LOC :n/v: ]

# --- NOMINAL DERIVATION (Highly Productive in myk.txt) ---
section nominal_derivation
pattern :n: [ {|vɔɔ}:: ] | :n: [ :v/n: :mrph:AG.SG ]
pattern :n: [ {|fɛɛ}:: ] | :n: [ :v/n: :mrph:AG.PL ]
pattern :n: [ {|pye}:: ] | :n: [ :v/n: :mrph:NMLZ ]
pattern :n: [ {|gana}:: ] | :n: [ :v: :mrph:NMLZ.MANNER ]
pattern :n: [ {|duun}:: ] | :n: [ :v: :mrph:NMLZ.TIME ]
pattern :n: [ {|xuu}:: ] | :n: [ :v: :mrph:LOC.PLACE ]
pattern :n: [ {|ya}:: ] | :n: [ :n/adj: :mrph:ABSTR ]
pattern :n: [ {|bo}:: ] | :n: [ :n: :mrph:DIM.SG ]
pattern :n: [ {|biile}:: ] | :n: [ :n: :mrph:DIM.PL ]
# Hyphenated enclitics (-ɛ, -pɛɛŋɛ, -nɔhɔ)
pattern :n/v: [ {|-pɛɛŋɛ}:: ] | :n/v: [ :n/v: :mrph:REFL ]
pattern :n/v: [ {|-nɔhɔ}:: ] | :n/v: [ :n/v: :mrph:RECP ]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :v: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :v: [ :v: :: :v: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :n: [ :n: :: :n: ]
pattern :adv: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :adv: [ :adv: :: :adv: ]

# --- POS COMPOSITION ---
section pos_composition
pattern :n: [ :n: :n: ] | :n: [ :n: :n: ]
pattern :n: [ :n: :adj: ] | :n: [ :n: :adj: ]
pattern :n: [ :v: :n: ] | :n: [ :v: :n: ]
pattern :n: [ :n: :v: ] | :n: [ :n: :v: ]
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]
pattern :n: [ :n: :v: :n: ] | :n: [ :n: :v: :n: ]

# --- LOANWORDS / NON-MAMARA FILTER (STAGE 4 = EMPR) ---
section loanwords
# Reject foreign characters (q, x, French accents/implosives; allows Mamara tones, ɲ, ŋ, ɔ, ɛ, ʃ, ʼ, homoglyphs)
pattern <re>.*[qxQXɓɗƴçäëïöüâêîôûøðþ].*</re>:: | ::EMPR

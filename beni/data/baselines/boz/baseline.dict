\xe L'enfant a grandi.
\xf The child has grown.

\lx paa
\ps mrph
\gf préfixe
\ge prefix
\ph paː
\gvf préfixe
\gve prefix
\sm Élément qui se place au début d'un mot pour en modifier le sens.
\ms 1
\xv Paa + tele = paatele.
\xe Paa + demander = demander (à propos de).
\xf Paa + to ask = to ask (about).

\lx paatele
\ps v
\gf demander (à propos de)
\ge to ask about, to inquire
\ph paːtele
\vl 2
\gvf s'enquérir

# Songhay (Koyraboro Senni & Koyra Chiini, ses) morphotactic patterns
# version 2026.11.23 — revised from beni/data/raw/ses.txt & test.json
# Supports BOTH Koyraboro Senni (-di, -yo, -diyo, -yaŋ) and Koyra Chiini (-oo, -aa, -ey, -yan)

# macro definitions (fixed: leading .*)
macro   @v@             <re>.*[aoeiu]</re>
macro   @cons@          <re>.*[bcdfghjklmnɲŋprstwyzšž]</re>
macro   @syl@           [^aoeiu]*(?P<V>[aoeiu])(?P=V)?

# processing instructions
plan
for token:
stage 0 add parallel parse inflection
stage 0 add parallel parse common_derivation
stage 0 apply lookup
return if parsed
stage 1 add sequential parse n_v_derivation
stage 1 add parallel parse n_derivation
stage 1 add parallel parse v_derivation
stage 1 add parallel parse num_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse nonSES
return if parsed

# --- INFLECTION (Definiteness & Plurality across KS and KC) ---
section inflection
# Koyraboro Senni definite singular (-di), plural (-yo), definite plural (-diyo)
pattern :n/adj/ptcp/n.prop: [ {|di}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:DEF.SG ]
pattern :n/adj/ptcp/n.prop: [ {|yo}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:PL ]
pattern :n/adj/ptcp/n.prop: [ {|diyo}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:DEF.PL ]

# Koyra Chiini definite singular (-oo, -aa) & plural (-ey, -wey, vowel+y)
pattern :n/adj/ptcp/n.prop: [ {|oo}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:DEF.SG ]
pattern :n/adj/ptcp/n.prop: [ {|aa}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:DEF.SG ]
pattern :n/adj/ptcp/n.prop: [ {|ey}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:DEF.PL ]
pattern :n/adj/ptcp/n.prop: [ {|wey}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:DEF.PL ]
pattern :n/adj/ptcp/n.prop: [ {@v@|y}:: ] | :n/adj/ptcp/n.prop: [ :n/adj/ptcp/n.prop: :mrph:PL ]

# --- COMMON DERIVATION ---
section common_derivation
# Nominalization / abstract (-yan, -yaŋ, -yanoo, -yaŋoo, -yaa, -taray)
pattern :n/adj/v: [ {|yanoo}:: ] | :n: [ :n/adj/v: :mrph:NMLZ :mrph:DEF.SG ]
pattern :n/adj/v: [ {|yan}:: ] | :n: [ :n/adj/v: :mrph:NMLZ ]
pattern :n/adj/v: [ {|yaŋ}:: ] | :n: [ :n/adj/v: :mrph:NMLZ ]
pattern :n/adj/v: [ {|yaa}:: ] | :n: [ :n/adj/v: :mrph:ABSTR ]
pattern :n/adj/v: [ {|taray}:: ] | :n: [ :n/adj/v: :mrph:ABSTR ]
pattern :n/adj/v: [ {|yandey}:: ] | :n: [ :n/adj/v: :mrph:ABSTR :mrph:PL ]
# Resultative participle / adjective (-ante, -antaa, -antey)
pattern :v/ptcp: [ {|ante}:: ] | :ptcp: [ :v: :mrph:PTCP.RES ]
pattern :v/ptcp: [ {|antaa}:: ] | :ptcp: [ :v: :mrph:PTCP.RES :mrph:DEF.SG ]
pattern :v/ptcp: [ {|antey}:: ] | :ptcp: [ :v: :mrph:PTCP.RES :mrph:PL ]

# --- RELATIONAL CLITICS ---
section n_v_derivation
# Postpositions when fused (-ra, -do, -se, -ga)
pattern :n/n.prop: [ {|ra}:: ] | :n/n.prop: [ :n/n.prop: :mrph:LOC ]
pattern :n/n.prop: [ {|do}:: ] | :n/n.prop: [ :n/n.prop: :mrph:ALL ]

# --- NOMINAL DERIVATION ---
section n_derivation
# Agentive (-koy, -kaw, -kaa, -key), Diminutive (-ize, -izey, -ije, -ijeyo, -izoo, -kayna), Augmentative (-beeri, -boobo)
pattern :n: [ {|koy}:: ] | :n: [ :v/n: :mrph:AG ]
pattern :n: [ {|kaw}:: ] | :n: [ :v/n: :mrph:AG ]
pattern :n: [ {|kaa}:: ] | :n: [ :v/n: :mrph:AG ]
pattern :n: [ {|-ize}:: ] | :n: [ :n: :mrph:DIM ]
pattern :n: [ {|-izey}:: ] | :n: [ :n: :mrph:DIM :mrph:PL ]
pattern :n: [ {|-izoo}:: ] | :n: [ :n: :mrph:DIM :mrph:DEF.SG ]
pattern :n: [ {|-ije}:: ] | :n: [ :n: :mrph:DIM ]
pattern :n: [ {|-ijeyo}:: ] | :n: [ :n: :mrph:DIM :mrph:PL ]
pattern :n/adj: [ {|kayna}:: ] | :n/adj: [ :n/adj: :mrph:DIM ]

# --- VERBAL DERIVATION ---
section v_derivation
# Causative (-ndi, -andi, -tandi), Verbal noun (-ri)
pattern :v: [ {|andi}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :v: [ {|tandi}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :v: [ {|ndi}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :n: [ {|ri}:: ] | :n: [ :v: :mrph:NMLZ ]

# --- NUMERAL DERIVATION ---
section num_derivation
pattern :num: [ {|yandey}:: ] | :num: [ :num: :mrph:DISTR ]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :num: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :num: [ :num: :num: ]
pattern :v: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :v: [ :v: :: :v: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :n: [ :n: :: :n: ]

# --- POS COMPOSITION ---
section pos_composition
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n/v: :n: ] | :n: [ :n/v: :n: ]
pattern :n/v: [ :n: :v: ] | :n/v: [ :n: :v: ]
pattern :n: [ :n: :adj/num: ] | :n: [ :n: :adj/num: ]
pattern :n: [ :pp: :n: ] | :n: [ :pp: :n: ]
pattern :n: [ :n: :adj/pp/num: :n: ] | :n: [ :n: :adj/pp/num: :n: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]

# --- NON-SONGHAY FILTER (STAGE 4 = EMPR) ---
section nonSES
# Reject characters outside Songhay orthography (allows a-z excl q,v,x + ɲ, ŋ, š, ž, é)
pattern <re>.*[qvxQVXɓɗƴɔɛçäëïöüâêîôûùàøðþ].*</re>:: | ::EMPR

# Soninke (snk) morphotactic patterns
# version 2026.11.23 — revised from beni/data/raw/snk.txt & test.json
# Removed copy-pasted Songhay (-kayna) and Bambara (vq_derivation) rules.

# macro definitions
macro   @v@             <re>.*[aoeiu]</re>
macro   @cons@          <re>.*[bcdfghjklmnɲŋprstwx y]</re>
macro   @syl@           [^aoeiu]*(?P<V>[aoeiu])(?P=V)?

# processing instructions
plan
for token:
stage 0 add parallel parse inflection
stage 0 add parallel parse common_derivation
stage 0 apply lookup
return if parsed
stage 1 add sequential parse n_v_derivation
stage 1 add parallel parse n_derivation
stage 1 add parallel parse v_derivation
stage 1 add parallel parse num_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse nonSNK
return if parsed

# --- INFLECTION (Definiteness & Plurality) ---
section inflection
# Plural markers (-nu, -nun, -u, -xen, -ye, -wi)
pattern :n/adj/prn/n.prop/num: [ {|nun}:: ] | :n/adj/prn/n.prop/num: [ :n/adj/prn/n.prop/num: :mrph:PL ]
pattern :n/adj/prn/n.prop/num: [ {|nu}:: ] | :n/adj/prn/n.prop/num: [ :n/adj/prn/n.prop/num: :mrph:PL ]
pattern :n/adj/prn/n.prop/num: [ {|xen}:: ] | :n/adj/prn/n.prop/num: [ :n/adj/prn/n.prop/num: :mrph:PL ]
pattern :n/adj/prn/n.prop/num: [ {|ye}:: ] | :n/adj/prn/n.prop/num: [ :n/adj/prn/n.prop/num: :mrph:PL ]
pattern :n/adj/prn/n.prop/num: [ {|wi}:: ] | :n/adj/prn/n.prop/num: [ :n/adj/prn/n.prop/num: :mrph:PL ]
# Definite/connective -n after vowel-final stems (e.g., jamaane -> jamaanen, sariya -> sariyan)
pattern :n/adj/ptcp: [ {<re>.*[aoeiu]</re>|n}:: ] | :n/adj/ptcp: [ :n/adj/ptcp: :mrph:DEF ]

# --- COMMON DERIVATION ---
section common_derivation
# Abstract quality (-maaxu, -yaaxu, -aaxu, -ya)
pattern :n/adj: [ {|maaxu}:: ] | :n: [ :n/adj: :mrph:ABSTR ]
pattern :n/adj: [ {|yaaxu}:: ] | :n: [ :n/adj: :mrph:ABSTR ]
pattern :n/adj: [ {|aaxu}:: ] | :n: [ :n/adj: :mrph:ABSTR ]
pattern :n/adj/v: [ {|ya}:: ] | :n: [ :n/adj/v: :mrph:ABSTR ]
# Augmentative (-ba) & Diminutive (-lempe, -lenne, -ne)
pattern :n/adj: [ {|ba}:: ] | :n/adj: [ :n/adj: :mrph:AUGM ]
pattern :n/adj: [ {|lempe}:: ] | :n/adj: [ :n/adj: :mrph:DIM ]

# --- LOCATIVE / RELATIONAL ---
section n_v_derivation
# Locative / associative (-ra, -xa, -kunda place/lineage)
pattern :n/n.prop: [ {|kunda}:: ] | :n: [ :n/n.prop: :mrph:LOC.PLACE ]
pattern :n/n.prop: [ {|ra}:: ] | :n/n.prop: [ :n/n.prop: :mrph:LOC ]
pattern :n/n.prop: [ {|xa}:: ] | :n/n.prop: [ :n/n.prop: :mrph:LOC ]

# --- NOMINAL DERIVATION ---
section n_derivation
# Agentive (-ndaanu, -ndaano, -xaane, -gala, -xe), Gentilic (-nke, -ŋke)
pattern :n: [ {|ndaanu}:: ] | :n: [ :v/n: :mrph:AG ]
pattern :n: [ {|ndaano}:: ] | :n: [ :v/n: :mrph:AG.DEF ]
pattern :n: [ {|xaane}:: ] | :n: [ :v/n: :mrph:AG ]
pattern :n: [ {|gala}:: ] | :n: [ :v/n: :mrph:AG ]
pattern :n/n.prop: [ {|nke}:: ] | :n: [ :n/n.prop: :mrph:GENT ]
pattern :n/n.prop: [ {|ŋke}:: ] | :n: [ :n/n.prop: :mrph:GENT ]
# Privative (-ntange, -tange, -ma)
pattern :adj/n: [ {|ntange}:: ] | :adj/n: [ :n: :mrph:PRIV ]
pattern :adj/n: [ {|tange}:: ] | :adj/n: [ :n: :mrph:PRIV ]
pattern :adj/n: [ {|ma}:: ] | :adj/n: [ :n: :mrph:PRIV ]

# --- VERBAL DERIVATION & PARTICIPLES ---
section v_derivation
# Causative (-ndi), Intransitive/Iterative (-an, -in), Verbal nouns (-ni, -ne, -nde, -nden, -re, -xi), Participle (-nte, -nten)
pattern :v: [ {|ndi}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :n: [ {|nde}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :n: [ {|nden}:: ] | :n: [ :v: :mrph:NMLZ :mrph:DEF ]
pattern :n: [ {|ni}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :n: [ {|ne}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :n: [ {|re}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :n: [ {|xi}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :v/ptcp: [ {|nte}:: ] | :ptcp: [ :v: :mrph:PTCP.RES ]
pattern :v/ptcp: [ {|nten}:: ] | :ptcp: [ :v: :mrph:PTCP.RES :mrph:DEF ]

# --- NUMERAL DERIVATION ---
section num_derivation
pattern :num: [ {|ndi}:: ] | :adj: [ :num: :mrph:ORD ]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :num: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :num: [ :num: :num: ]
pattern :v: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :v: [ :v: :: :v: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :n: [ :n: :: :n: ]

# --- POS COMPOSITION ---
section pos_composition
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n/v: :n: ] | :n: [ :n/v: :n: ]
pattern :n/v: [ :n: :v: ] | :n/v: [ :n: :v: ]
pattern :n: [ :n: :adj/num: ] | :n: [ :n: :adj/num: ]
pattern :n: [ :pp: :n: ] | :n: [ :pp: :n: ]
pattern :n: [ :n: :adj/pp/num: :n: ] | :n: [ :n: :adj/pp/num: :n: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]
pattern :n: [ :v: ndi:mrph: :n: ] | :n: [ :v: :mrph:CAUS :n: ]

# --- NON-SONINKE FILTER (STAGE 4 = EMPR) ---
section nonSNK
# Note: Soninke uses q and x natively (roraqe, maaxu, xibaaru), so only v, z, French accents are EMPR
pattern <re>.*[vzVZɓɗƴçäëïöüâêîôûùøðþ].*</re>:: | ::EMPR

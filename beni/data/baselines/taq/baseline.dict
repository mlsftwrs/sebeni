\xv Azulej: ǎhaləs. Ăjut: meddăn.
\xe Singulier : homme. Pluriel : gens.
\xf Singular: man. Plural: people.
\sy ăddinăt

\lx ăddunya
\va Tadghaq
\va ӑddunya
\ps n
\gf le monde
\ge the world
\ph [ədːunja]
\gvf monde
\gve world
\sm 1 La Terre et l'ensemble de ses habitants.
\ms 1
\xv ăddunya=le monde
\xe Le monde
\xf The world

\lx tăfukt
\va Tadghaq
\va tӑfukt
\ps n
\gf le soleil
\ge the sun
\ph [təfukt]
\gvf soleil
\gve sun
\sm 1 L'étoile autour de laquelle la Terre gravite.
\ms 1
\xv tăfukt=le soleil (pas de masculin)
\xe Le soleil (pas de masculin)
\xf The sun (no masculine form)

\lx əlməd
\va Tadghaq
\va әlmәd
\ps v
\gf apprendre
\ge to learn
\ph [əlməd]
\gvf apprendre
\gve to learn
\sm 1 Acquérir une connaissance ou une compétence par l'étude, l'expérience ou l'enseignement.
\ms 1
\xv ∃lməd awal-năkk.
\xe Apprends ta leçon.
\xf Learn your lesson.

\lx əkf
\va Tadghaq
\va әkf
\ps v
\gf donner
\ge to give
\ph [əkf]
\gvf donner
\gve to give
\sm 1 Mettre quelque chose en la possession de quelqu'un.
\ms 1
\xv Ikf'-anăy, Ăkall-in, Isuf d- Mosa...
\xe Il m'a donné ma terre, Isuf et Mosa...
\xf He gave me my land, Isuf and Mosa...

\lx əfrəs
\va Tadghaq
\va әfrәs
\ps v
\gf couper ; abattre
\ge to cut; to slaughter
\ph [əfrəs]
\gvf couper
\gve to cut
\sm 1 Diviser quelque chose avec un instrument tranchant.
\ms 1
\xv Təw+ əfrəs =təwəfrəs
\xe Couper (forme active) -> être coupé (forme passive)
\xf To cut (active form) -> to be cut (passive form)

\lx ila
\va Tadghaq
\ps n
\gf il avait ; il y a
\ge he had; there is/was
\ph [ila]
\gvf il avait
\gve he had
\sm 1 Verbe défectif exprimant la possession au passé ou l'existence.
\ms 1
\xv Il y a des verbes défectifs comme ila, (qui veut dire : il avait).
\xe Il y a des verbes défectifs comme ila, (qui veut dire : il avait).
\xf There are defective verbs like ila, (which means: he had).

\lx illa
\va Tadghaq
\ps n
\gf il se trouvait à ; il est
\ge he was at; he is
\ph [ilːa]
\gvf il est
\gve he is
\sm 1 Verbe défectif exprimant la présence ou l'existence en un lieu.
\ms 1
\xv ...illa (il se trouvait à...).
\xe ...illa (il se trouvait à...).
\xf ...illa (he was at...).

\lx siha
\va Tadghaq
\ps n
\gf ici (direction vers le locuteur)
\ge here (direction towards speaker)
\ph [siha]
\gvf ici
\gve here
\sm 1 Déictique verbal de 1er degré indiquant une orientation vers le locuteur.
\ms 1
\xv Siha
\xe Ici (1er degré)
\xf Here (1st degree)
\sy diha
\an sihen

\lx sidi
\va Tadghaq
\ps n
\gf ici (proximité du locuteur)
\ge here (proximity to speaker)
\ph [sidi]
\gvf ici
\gve here
\sm 1 Déictique verbal de 2ème degré indiquant la proximité du locuteur.
\ms 1
\xv Sidi
\xe Ici (2ème degré)
\xf Here (2nd degree)
\sy dədi
\an sihen

\lx sihen
\va Tadghaq
\ps n
\gf là-bas (éloignement)
\ge over there (distance)
\ph [sihen]
\gvf là-bas
\gve there
\sm 1 Déictique verbal de 3ème degré indiquant l'éloignement du locuteur.
\ms 1
\xv Sihen
\xe Là-bas (3ème degré)
\xf Over there (3rd degree)
\sy dihen
\an siha

\lx diha
\va Tawəlləmmədt
\ps n
\gf ici (direction vers le locuteur)
\ge here (direction towards speaker)
\ph [diha]
\gvf ici
\gve here
\sm 1 Déictique verbal de 1er degré, variante de `siha` notamment en Tawəlləmmədt.
\ms 1
\xv Diha
\xe Ici (1er degré)
\xf Here (1st degree)
\sy siha
\an dihen

\lx năkk
\va năkku
\va Tadghaq
\va nӑkk
\ps pers
\gf moi ; je
\ge I; me
\ph [nəkː]
\gvf moi
\gve I
\sm 1 Pronom personnel indépendant de la première personne du singulier.
\ms 1
\xv Năkkăned nəgla.
\xe Nous (masc.) sommes partis.
\xf We (masc.) have left.

\lx kăyy
\va kăyyu
\va Tadghaq
\va kӑyy
\ps pers
\gf toi (masculin)
\ge you (masculine singular)
\ph [kəjː]
\gvf toi
\gve you
\sm 1 Pronom personnel indépendant de la deuxième personne du masculin singulier.
\ms 1
\xv Kăyy kăttabăd.
\xe Toi, tu écris.
\xf You are writing.

\lx kămm
\va kămmu
\va Tadghaq
\va kӑmm
\ps pers
\gf toi (féminin)
\ge you (feminine singular)
\ph [kəmː]
\gvf toi
\gve you
\sm 1 Pronom personnel indépendant de la deuxième personne du féminin singulier.
\ms 1
\xv Kămm(u)
\xe Toi (fém.)
\xf You (fem.)

\lx ănta
\va Tadghaq
\va ӑnta
\ps pers
\gf lui ; il
\ge he; him
\ph [ənta]
\gvf lui
\gve he
\sm 1 Pronom personnel indépendant de la troisième personne du masculin singulier.
\ms 1
\xv Făţma təla turuft, Biga ənta ila ešed.
\xe Fatma a une robe, Biga lui a une chemise.
\xf Fatma has a dress, Biga he has a shirt.

\lx tăyule
\va Tadghaq
\va tӑyule
\ps adj
\gf jaune
\ge yellow
\ph [təjule]
\gvf jaune
\gve yellow
\sm 1 De la couleur du citron ou du soleil.
\ms 1
\xv tăyule
\xe jaune
\xf yellow

\lx tăddarăt
\va Tadghaq
\va tӑddarӑt
\ps adj
\gf rouge
\ge red
\ph [tədːarət]
\gvf rouge
\gve red
\sm 1 De la couleur du sang.
\ms 1
\xv tăddarăt
\xe rouge
\xf red

\lx təfəsse
\va Tadghaq
\va tәfәsse
\ps adj
\gf lourd
\ge heavy
\ph [təfəsːe]
\gvf lourd
\gve heavy
\sm 1 Qui a un poids élevé.
\ms 1
\xv Təfəsse təlămde; aləmmez; ăzuk, d.s.w (etc.)
\xe Lourd, léger, moyen, poids, etc.
\xf Heavy, light, medium, weight, etc.
\an təlămde

\lx təlămde
\va Tadghaq
\va tәlӑmde
\ps adj
\gf léger
\ge light (in weight)
\ph [tələmde]
\gvf léger
\gve light
\sm 1 Qui a un faible poids.
\ms 1
\xv Təfəsse təlămde; aləmmez; ăzuk, d.s.w (etc.)
\xe Lourd, léger, moyen, poids, etc.
\xf Heavy, light, medium, weight, etc.
\an təfəsse

\lx sollan
\va Tadghaq
\ps adv
\gf vite ; rapidement
\ge quickly; fast
\ph [solːan]
\gvf vite
\gve quickly
\sm 1 Adverbe de manière indiquant une grande vitesse.
\ms 1
\xv Irjăš sollan
\xe Il a agi vite.
\xf He acted quickly.

\lx ujəjjăn
\va Tadghaq
\va ujәjjӑn
\ps adv
\gf loin ; éloigné
\ge far; distant
\ph [uʒəʒːən]
\gvf loin
\gve far
\sm 1 Adverbe de lieu indiquant une grande distance.
\ms 1
\xv Ikka edăgg ujəjjăn.
\xe Il est allé dans un lieu éloigné.
\xf He went to a distant place.
\an ohazăn

\lx ohazăn
\va Tadghaq
\va ohazӑn
\ps adv
\gf près ; proche
\ge near; close
\ph [ohazən]
\gvf près
\gve near
\sm 1 Adverbe de lieu indiquant une faible distance.
\ms 1
\xv Ikka edăgg ohazăn.
\xe Il est allé dans un lieu proche.
\xf He went to a nearby place.
\an ujəjjăn

\lx hărkuk
\va Tadghaq
\va hӑrkuk
\ps adv
\gf jamais
\ge never
\ph [hərkuk]
\gvf jamais
\gve never
\sm 1 Adverbe de temps marquant la négation absolue dans le passé, le présent ou l'avenir.
\ms 1
\xv wăr dd- itis hărkuk
\xe Il ne dort jamais.
\xf He never sleeps.

\lx ăjjootnen
\va Tadghaq
\va ӑjjootnen
\ps adv
\gf beaucoup
\ge many; a lot
\ph [əʒːoːtnen]
\gvf beaucoup
\gve many
\sm 1 Adverbe de quantité indiquant un grand nombre.
\ms 1
\xv əlan iwan ăjjootnen
\xe Il y a beaucoup de bœufs.
\xf There are many oxen.
\an dărusnen

\lx dărusnen
\va Tadghaq
\va dӑrusnen
\ps adv
\gf peu
\ge few; little
\ph [dərusnen]
\gvf peu
\gve few
\sm 1 Adverbe de quantité indiquant un petit nombre.
\ms 1
\xv əlan iwan dărusnen
\xe Il y a peu de bœufs.
\xf There are few oxen.
\an ăjjootnen

\lx lăbasăn
\va Tadghaq
\va lӑbasӑn
\ps adv
\gf bien
\ge well
\ph [ləbasən]
\gvf bien
\gve well
\sm 1 Adverbe de qualité indiquant une manière satisfaisante.
\ms 1
\xv itajj əššavəl lăbasăn
\xe Il fait bien son travail.
\xf He does his work well.

\lx iyya
\va Tadghaq
\ps adv
\gf oui
\ge yes
\ph [ijːa]
\gvf oui
\gve yes
\sm 1 Adverbe utilisé pour répondre affirmativement à une question.
\ms 1
\xv Iyya, exǎy, iddutăt, hullan, ewăļļa d.s.w. (etc.)
\xe Oui, certes, certainement, sûrement, par Dieu, etc.
\xf Yes, indeed, certainly, surely, by God, etc.

\lx exăy
\va Tadghaq
\va exӑy
\ps adv
\gf certes ; en effet
\ge indeed; certainly
\ph [exəj]
\gvf certes
\gve indeed
\sm 1 Adverbe d'affirmation renforçant une assertion.
\ms 1
\xv Exăy, Ănn bahu.
\xe Certes, le père est là.
\xf Indeed, the father is here.

\lx iddutăt
\va Tadghaq
\va iddutӑt
\ps adv
\gf certainement
\ge certainly
\ph [idːutət]
\gvf certainement
\gve certainly
\sm 1 Adverbe d'affirmation exprimant la certitude.
\ms 1
\xv iyya, exǎy, iddutăt, hullan...
\xe Oui, certes, certainement, sûrement...
\xf Yes, indeed, certainly, surely...

\lx hullan
\va Tadghaq
\ps adv
\gf sûrement
\ge surely
\ph [hulːan]
\gvf sûrement
\gve surely
\sm 1 Adverbe d'affirmation exprimant une forte probabilité ou une conviction.
\ms 1
\xv iyya, exǎy, iddutăt, hullan...
\xe Oui, certes, certainement, sûrement...
\xf Yes, indeed, certainly, surely...

\lx ewăļļa
\va Tadghaq
\va ewӑļļa
\ps adv
\gf par Dieu
\ge by God
\ph [ewəɬːa]
\gvf par Dieu
\gve by God
\sm 1 Adverbe d'affirmation utilisé comme un serment pour renforcer une déclaration.
\ms 1
\xv iyya, exǎy, iddutăt, hullan, ewăļļa d.s.w. (etc.)
\xe Oui, certes, certainement, sûrement, par Dieu, etc.
\xf Yes, indeed, certainly, surely, by God, etc.

\lx iha-miši
\va Tadghaq
\ps adv
\gf peut-être
\ge maybe; perhaps
\ph [ihamiʃi]
\gvf peut-être
\gve maybe
\sm 1 Adverbe de doute exprimant l'incertitude, la possibilité.
\ms 1
\xv Iha-miši s-ad iwət ajənna.
\xe Peut-être qu'il pleuvra.
\xf Maybe it will rain.

\lx ordex
\va ordey
\va Tadghaq
\ps adv
\gf probablement
\ge probably
\ph [ordex]
\gvf probablement
\gve probably
\sm 1 Adverbe de doute exprimant une forte probabilité.
\ms 1
\xv Ordey s-hin malăy-in.
\xe Probablement qu'ils me le diront.
\xf They will probably tell me.

\lx wăr-əkkesăy ăššăk
\va Tadghaq
\va wӑr-әkkesӑy ӑššӑk
\ps adv
\gf sans doute
\ge without a doubt
\ph [wər əkːesəj əʃːək]
\gvf sans doute
\gve doubtless
\sm 1 Locution adverbiale exprimant la certitude.
\ms 1
\xv wăr-əkkesăy ăššăk
\xe sans doute
\xf without a doubt

\lx olăh
\va Tadghaq
\va olӑh
\ps adv
\gf il se peut que
\ge it may be that
\ph [oləh]
\gvf il se peut que
\gve maybe
\sm 1 Locution adverbiale exprimant la possibilité.
\ms 1
\xv olăh d-awen
\xe il se peut que
\xf it may be that
\sy iha-miši

\lx mey
\va Tadghaq
\ps conj
\gf ou
\ge or
\ph [mej]
\gvf ou
\gve or
\sm 1 Conjonction de coordination marquant un choix, une alternative.
\ms 1
\xv Sidi mey- Žəddu
\xe Sidi ou Jiddou
\xf Sidi or Jiddou

\lx mušăm
\va mušăn
\va Tadghaq
\va mušӑm
\ps conj
\gf mais
\ge but
\ph [muʃəm]
\gvf mais
\gve but
\sm 1 Conjonction de coordination marquant une opposition, une restriction.
\ms 1
\xv Århey-tăt mušăn əksudăy-tăt.
\xe Je l'aime, mais j'ai peur d'elle.
\xf I love her, but I am afraid of her.

\lx wăla-
\va Tadghaq
\va wӑla-
\ps conj
\gf ni
\ge nor
\ph [wəla]
\gvf ni
\gve nor
\sm 1 Conjonction de coordination négative utilisée pour lier deux éléments dans une phrase négative.
\ms 1
\xv Wăr-ənheyăy Sidi wăla- Žəddu.
\xe Je ne vois ni Sidi ni Jiddou.
\xf I see neither Sidi nor Jiddou.

\lx adiš
\va Tadghaq
\ps conj
\gf donc
\ge so; therefore
\ph [adiʃ]
\gvf donc
\gve therefore
\sm 1 Conjonction de coordination marquant la conséquence.
\ms 1

\_sh v3.0  400  MDF 4.0

\lang taq
\name seben-tamasheq
\ver 0.2.0

\lx ăddăwlăt
\va ăddăwlet
\va ӑddӑwlӑt
\ps n
\gf état ; nation ; pays
\ge state; nation; country
\ph [ədːəwlət]
\di Tawallammat T-an-Mali
\gvf état
\gve state
\sm 1 Entité politique et juridique souveraine occupant un territoire défini, habitée par une population et dotée d'un gouvernement.
\ms 1
\xv ĂDDĂWLĂT N-MALI
\xe L'État du Mali
\xf The State of Mali
\sy tamurt

\lx tamətte
\va taməttay
\va tamәtte
\ps n
\gf peuple ; nation ; communauté
\ge people; nation; community
\ph [təmətːe]
\di Tawallammat T-an-Mali
\gvf peuple
\gve people
\sm 1 Ensemble des personnes vivant dans un même pays, constituant une nation.
\ms 1
\xv Tamәtte n-Mali tәbdadӑt fӑll-iman-net.
\xe Le peuple du Mali est souverain.
\xf The people of Mali are sovereign.
\sy aɣərf

\lx ittus
\va itus
\ps n
\gf but ; objectif ; finalité
\ge goal; objective; aim
\ph [itːus]
\di Tawallammat T-an-Mali
\gvf but
\gve goal
\sm 1 Ce que l'on se propose d'atteindre ; le point final d'une action ou d'une aspiration.
\ms 1
\xv Tamәtte Iyyӑt – Ittus Iyyӑn – Erkӑwӑl Iyyӑn
\xe Un Peuple – Un But – Un Principe
\xf One People – One Goal – One Principle
\sy aniyyat

\lx erkăwăl
\va arkăwăl
\va erkӑwӑl
\ps n
\gf principe ; fondement ; foi
\ge principle; foundation; faith
\ph [erkəwəl]
\di Tawallammat T-an-Mali
\gvf principe
\gve principle
\sm 1 Règle fondamentale sur laquelle repose un système, une pensée ou une action.
\ms 1
\xv Tamәtte Iyyӑt – Ittus Iyyӑn – Erkӑwӑl Iyyӑn
\xe Un Peuple – Un But – Un Principe
\xf One People – One Goal – One Principle
\sy assas

\lx ăššăreɣa
\va aššăriɣa
\va ӑššӑreɣa
\ps n
\gf loi ; législation ; règle
\ge law; legislation; rule
\ph [əʃːəreɣa]
\di Tawallammat T-an-Mali
\gvf loi
\gve law
\sm 1 Ensemble des règles juridiques qui régissent les rapports entre les individus dans une société.
\ms 1
\xv BROŽE N- ĂŠŠĂREɣA WA MĂQQĂRĂN S-ITAWĂNNA KONSTITISYON N-ĂDDĂWLĂT N-MALI
\xe PROJET DE LA GRANDE LOI APPELÉE CONSTITUTION DE L'ÉTAT DU MALI
\xf DRAFT OF THE GREAT LAW CALLED THE CONSTITUTION OF THE STATE OF MALI
\sy alxaqq

\lx konstitisyon
\va konstitusyon
\ps n
\gf constitution
\ge constitution
\ph [konstitisjon]
\di Tawallammat T-an-Mali
\gvf constitution
\gve constitution
\sm 1 Loi fondamentale d'un État qui définit les droits et les libertés des citoyens ainsi que l'organisation et les séparations du pouvoir politique.
\ms 1
\xv Tәqbӑl brože n-konstitisyon-wa dӑɣ-әḍḍiinnӑt tizizar-ti s-aɣrud-nӑsnӑt.
\xe Accepte ce projet de constitution dans ces termes avec son contenu.
\xf Accepts this draft constitution in these terms with its content.
\sy ăššăreɣa wa măqqărăn

\lx ălxaqq
\va alḥaqq
\va ӑlxaqq
\ps n
\gf droit ; prérogative
\ge right; prerogative
\ph [əlxaqː]
\di Tawallammat T-an-Mali
\gvf droit
\gve right
\sm 1 Ce qui est permis ou exigible en vertu d'une règle morale ou juridique.
\ms 1
\xv EƔӐF I: ĂLXAQQӐN D-ILUZAM
\xe CHAPITRE I : LES DROITS ET LES DEVOIRS
\xf CHAPTER I: RIGHTS AND DUTIES
\an iluzam

\lx iluzam
\va iluzamən
\ps n
\gf devoirs ; obligations
\ge duties; obligations
\ph [iluzam]
\di Tawallammat T-an-Mali
\gvf devoirs
\gve duties
\sm 1 Ce à quoi on est obligé par la loi, la morale ou les convenances.
\ms 1
\xv ĂLBAB II: ILUZAM
\xe PARTIE II : LES DEVOIRS
\xf PART II: DUTIES
\an ălxaqqăn

\lx ălxoriyyăt
\va alḥurriyat
\va ӑlxoriyyӑt
\ps n
\gf liberté ; indépendance
\ge freedom; liberty; independence
\ph [əlxorijːət]
\di Tawallammat T-an-Mali
\gvf liberté
\gve freedom
\sm 1 État de celui qui n'est pas soumis à la puissance d'un autre, qui ne subit pas de contrainte.
\ms 1
\xv ĂLXAQQӐN D- ӐLXORIYYӐTӐN
\xe LES DROITS ET LES LIBERTÉS
\xf RIGHTS AND FREEDOMS
\an tăhănšareḍt

\lx eɣəf
\va iɣəf
\va eɣәf
\ps n
\gf tête ; chef ; chapitre
\ge head; chief; chapter
\ph [eɣəf]
\di Tawallammat T-an-Mali
\gvf chapitre
\gve chapter
\sm 1 Division principale d'un livre ou d'un document juridique.
\ms 1
\xv EƔӐF I: ĂLXAQQӐN D-ILUZAM
\xe CHAPITRE I : LES DROITS ET LES DEVOIRS
\xf CHAPTER I: RIGHTS AND DUTIES

\lx ălbab
\va albab
\va ӑlbab
\ps n
\gf porte ; partie ; section
\ge door; part; section
\ph [əlbab]
\di Tawallammat T-an-Mali
\gvf partie
\gve part
\sm 1 Subdivision d'un chapitre dans un texte législatif ou un ouvrage.
\ms 1
\xv ĂLBAB I: ĂLXAQQӐN D- ӐLXORIYYӐTӐN
\xe PARTIE I : LES DROITS ET LES LIBERTÉS
\xf PART I: RIGHTS AND FREEDOMS

\lx inaxkim
\va anaxkim
\ps n
\gf autorité ; pouvoir
\ge authority; power
\ph [inaxkim]
\di Tawallammat T-an-Mali
\gvf autorité
\gve authority
\sm 1 Organe ou institution détenant le pouvoir de gouverner, de commander et de prendre des décisions.
\ms 1
\xv EƔӐF III : INAXKIMӐN WI ӘSSIRJӐSNEN ӐDDӐWLӐT
\xe CHAPITRE III : LES POUVOIRS QUI GÈRENT L'ÉTAT
\xf CHAPTER III: THE POWERS THAT MANAGE THE STATE
\sy tămmănăya

\lx ămănokal
\va amenokal
\va ӑmӑnokal
\ps n
\gf roi ; chef suprême ; président
\ge king; supreme chief; president
\ph [əmənokal]
\di Tawallammat T-an-Mali
\gvf président
\gve president
\sm 1 Le chef de l'État dans une république, élu par le peuple.
\ms 1
\xv ĂMӐNOKAL N-ӐDDӐWLӐT
\xe LE PRÉSIDENT DE L'ÉTAT
\xf THE PRESIDENT OF THE STATE
\sy emənnəɣəf

\lx ălxəkum
\va alḥukum
\va ӑlxәkum
\ps n
\gf gouvernement ; pouvoir exécutif
\ge government; executive power
\ph [əlxəkum]
\di Tawallammat T-an-Mali
\gvf gouvernement
\gve government
\sm 1 Ensemble des personnes et des organismes qui exercent le pouvoir exécutif dans un État.
\ms 1
\xv ĂLBAB II: ĂLXӘKUM
\xe PARTIE II : LE GOUVERNEMENT
\xf PART II: THE GOVERNMENT

\lx axăkam
\va akhăkam
\va axӑkam
\ps n
\gf administration ; gestion
\ge administration; management
\ph [axəkam]
\di Tawallammat T-an-Mali
\gvf administration
\gve administration
\sm 1 L'ensemble des services et agents publics chargés de l'exécution des lois et du fonctionnement des services publics.
\ms 1
\xv ĂLBAB III: AXӐKAM
\xe PARTIE III : L'ADMINISTRATION
\xf PART III: THE ADMINISTRATION

\lx kăl-ălɣəṣkər
\va kăl-ălɣaskăr
\va kӑl-ӑlɣәṣkәr
\ps n
\gf armée ; forces militaires
\ge army; military forces
\ph [kəl əlɣəsˤkər]
\di Tawallammat T-an-Mali
\gvf armée
\gve army
\sm 1 L'ensemble des forces militaires d'un État, chargées de la défense du territoire.
\ms 1
\xv ĂLBAB V: KӐL-ĂLƔӘṢKӘR
\xe PARTIE V : L'ARMÉE
\xf PART V: THE ARMY

\lx dәbәtet
\va debete
\va dəbətet
\ps n
\gf député ; représentant
\ge deputy; representative
\ph [dəbətet]
\di Tawallammat T-an-Mali
\gvf député
\gve deputy
\sm 1 Membre d'une assemblée législative, élu pour représenter une circonscription.
\ms 1
\xv EƔӐF IV: DӘBӘTETӐN (INAXKIMӐN WI SAMALNEN ӐSSӐREƔATӐN)
\xe CHAPITRE IV : LES DÉPUTÉS (LES POUVOIRS QUI FONT LES LOIS)
\xf CHAPTER IV: THE DEPUTIES (THE POWERS THAT MAKE THE LAWS)

\lx taggayt
\ps n
\gf groupe ; commission ; conseil
\ge group; commission; council
\ph [tagːajt]
\di Tawallammat T-an-Mali
\gvf conseil
\gve council
\sm 1 Organe consultatif ou délibératif chargé d'étudier des questions spécifiques et de donner des avis ou de prendre des décisions.
\ms 1
\xv TAGGAYT N-IMASRAƔӐN TA TӘSSӐMӐT
\xe LE CONSEIL SUPRÊME DES JUGES
\xf THE SUPREME COUNCIL OF JUDGES

\lx ăkall
\va akal
\va ӑkall
\ps n
\gf terre ; pays ; territoire
\ge land; country; territory
\ph [əkall]
\di Tawallammat T-an-Mali
\gvf territoire
\gve territory
\sm 1 Espace géographique délimité sur lequel s'exerce la souveraineté d'un État.
\ms 1
\xv ANӘḌḌӘM N-ӐKALL N-ӐDDӐWLӐT
\xe ORGANISATION DU TERRITOIRE DE L'ÉTAT
\xf ORGANIZATION OF THE STATE'S TERRITORY
\sy tamurt

\lx ăwadəm
\va awădəm
\va ӑwadәm
\ps n
\gf personne ; être humain ; individu
\ge person; human being; individual
\ph [əwadəm]
\di Tawallammat T-an-Mali
\gvf personne
\gve person
\sm 1 Être humain considéré en tant qu'individu, titulaire de droits et de devoirs.
\ms 1
\xv Hak ӑwadәm ila ӑlxaqq n-tӑmudre d-ӑlɣafyӑt d-atwigәẓ n-taɣәssa-net s-aɣrud.
\xe Toute personne a droit à la vie, à la sécurité et à la protection de son intégrité physique.
\xf Every person has the right to life, security, and the protection of their physical integrity.
\sy aggadəm

\lx tăhănšareḍt
\va tӑhӑnšareḍt
\ps n
\gf servitude ; esclavage
\ge servitude; slavery
\ph [təhənʃareɖt]
\di Tawallammat T-an-Mali
\gvf servitude
\gve servitude
\sm 1 État de dépendance totale d'une personne envers une autre, privation de liberté.
\ms 1
\xv Wӑr-t-illa ere tәlzam tӑhәnšareḍt, wӑla әkkәlu, wӑla talɣiwen fӑlla-s әkkasnen sӑrho, ӑsikӑrakӑḍnӑt-t.
\xe Nul ne sera soumis à la servitude, ni à l'esclavage, ni à la torture.
\xf No one shall be subjected to servitude, slavery, or torture.
\sy əkkəlu
\an ălxoriyyăt

\lx tămudre
\va tӑmudre
\ps n
\gf vie
\ge life
\ph [təmudre]
\di Tawallammat T-an-Mali
\gvf vie
\gve life
\sm 1 L'existence d'un être vivant, de la naissance à la mort.
\ms 1
\xv Hak ӑwadәm ila ӑlxaqq n-tӑmudre d-ӑlɣafyӑt d-atwigәẓ n-taɣәssa-net s-aɣrud.
\xe Toute personne a droit à la vie, à la sécurité et à la protection de son intégrité physique.
\xf Every person has the right to life, security, and the protection of their physical integrity.
\an taməttant

\lx ălɣafyăt
\va ӑlɣafyӑt
\ps n
\gf sécurité ; salut ; bien-être
\ge security; safety; well-being
\ph [əlɣafjət]
\di Tawallammat T-an-Mali
\gvf sécurité
\gve security
\sm 1 État d'esprit confiant et tranquille qui résulte de l'absence de danger ou de risque.
\ms 1
\xv Hak ӑwadәm ila ӑlxaqq n-tӑmudre d-ӑlɣafyӑt...
\xe Toute personne a droit à la vie et à la sécurité...
\xf Every person has the right to life and security...
\an aɣšad

\lx taɣəssa
\va taɣәssa
\ps n
\gf corps ; personne physique
\ge body; physical person
\ph [taɣəsːa]
\di Tawallammat T-an-Mali
\gvf corps
\gve body
\sm 1 L'entité physique et matérielle d'un être humain.
\ms 1
\xv ...atwigәẓ n-taɣәssa-net s-aɣrud.
\xe ...la protection de son intégrité physique.
\xf ...the protection of their physical integrity.
\sy iman

\lx aɣrud
\ps n
\gf intégrité ; totalité ; entièreté
\ge integrity; entirety
\ph [aɣrud]
\di Tawallammat T-an-Mali
\gvf intégrité
\gve integrity
\sm 1 Le caractère de ce qui est entier, complet, qui n'a subi aucune atteinte ou diminution.
\ms 1
\xv ...atwigәẓ n-taɣәssa-net s-aɣrud.
\xe ...la protection de son intégrité physique.
\xf ...the protection of their physical integrity.

\lx ăggadəm
\va ӑggadәm
\ps n
\gf être humain ; personne
\ge human being; person
\ph [əgːadəm]
\di Tawallammat T-an-Mali
\gvf être humain
\gve human being
\sm 1 Individu de l'espèce humaine, sans distinction de sexe ou d'âge.
\ms 1
\xv Ăggadәm ikna atwәsәmɣar, tӑtiwӑgdӑl-as tәhәnšareḍt.
\xe La personne humaine est sacrée et inviolable.
\xf The human person is sacred and inviolable.
\sy ăwadəm

\lx əššəɣəl
\va әššәɣәl
\ps n
\gf travail ; emploi ; activité
\ge work; labor; employment
\ph [əʃːəɣəl]
\di Tawallammat T-an-Mali
\gvf travail
\gve work
\sm 1 Activité humaine de production de biens ou de services, reconnue comme un droit fondamental.
\ms 1
\xv Ălxaqq wa n-әššәɣәl d-tӑsonfat, ijraw-t ӑwadәm a ӑmoos...
\xe Le droit au travail et au repos est reconnu à tout citoyen...
\xf The right to work and rest is recognized for every citizen...
\an tăsonfat

\lx teɣăre
\va teɣӑre
\ps n
\gf éducation ; instruction ; lecture
\ge education; instruction; reading
\ph [teɣəre]
\di Tawallammat T-an-Mali
\gvf éducation
\gve education
\sm 1 L'action d'enseigner et de former, de développer les facultés intellectuelles, morales et physiques.
\ms 1
\xv Teɣӑre, asәlmad n-әššәɣәl, әššәɣәl iman-net... ӑmoosӑn ӑlxaqqӑn әtbatnen i-ӑggadәm...
\xe L'éducation, la formation professionnelle, le travail lui-même... sont des droits établis pour l'être humain...
\xf Education, vocational training, work itself... are established rights for the human being...
\sy asəlmad

\lx adubən
\va adubәn
\ps n
\gf mariage
\ge marriage
\ph [adubən]
\di Tawallammat T-an-Mali
\gvf mariage
\gve marriage
\sm 1 Union légale et solennelle entre un homme et une femme, considérée comme la base de la famille.
\ms 1
\xv Adubәn d-ӑlɣӑyal i ӑmoosnen ӑssas n-tamәzzoɣt dӑɣ-tamәtte, ogaẓ-tӑn ӑššӑreɣa...
\xe Le mariage et la famille sont la base de la vie en société, la loi les protège...
\xf Marriage and family are the basis of life in society, the law protects them...

\lx ălɣăyal
\va ӑlɣӑyal
\ps n
\gf famille
\ge family
\ph [əlɣəjal]
\di Tawallammat T-an-Mali
\gvf famille
\gve family
\sm 1 Communauté de personnes unies par des liens de parenté ou d'alliance, constituant le noyau de base de la société.
\ms 1
\xv Adubәn d-ӑlɣӑyal i ӑmoosnen ӑssas n-tamәzzoɣt dӑɣ-tamәtte...
\xe Le mariage et la famille sont la base de la vie en société...
\xf Marriage and family are the basis of life in society...

\lx ăhaləs
\va ӑhalәs
\ps n
\gf homme
\ge man
\ph [əhaləs]
\di Tawallammat T-an-Mali
\gvf homme
\gve man
\sm 1 Être humain de sexe masculin.
\ms 1
\xv Adubәn ӑmoos a osaɣӑn ӑhalәs d-tamӑḍt.
\xe Le mariage est ce qui unit un homme et une femme.
\xf Marriage is what unites a man and a woman.
\an tamăḍt

\lx tamăḍt
\va tamӑḍt
\ps n
\gf femme
\ge woman
\ph [taməɖt]
\di Tawallammat T-an-Mali
\gvf femme
\gve woman
\sm 1 Être humain de sexe féminin.
\ms 1
\xv Adubәn ӑmoos a osaɣӑn ӑhalәs d-tamӑḍt.
\xe Le mariage est ce qui unit un homme et une femme.
\xf Marriage is what unites a man and a woman.
\an ăhaləs

\lx terše
\ps n
\gf propriété ; bien
\ge property; possession
\ph [terʃe]
\di Tawallammat T-an-Mali
\gvf propriété
\gve property
\sm 1 Droit de jouir et de disposer des choses de la manière la plus absolue, garanti par la loi.
\ms 1
\xv Ălxaqq wa n-terše iḍman.
\xe Le droit de propriété est garanti.
\xf The right to property is guaranteed.
\sy ălmal

\lx ăddin
\va ӑddin
\ps n
\gf religion ; foi
\ge religion; faith
\ph [ədːin]
\di Tawallammat T-an-Mali
\gvf religion
\gve religion
\sm 1 Ensemble de croyances, de pratiques et de rites propres à un groupe social, dont la liberté est garantie.
\ms 1
\xv Hak ӑwadәm ikf’ee ӑlxaqq ajӑraw -ӑššӑreɣa ӑsisӑgdӑhӑn ijan dӑɣ-tәqqәn tәhat edӑgg.
\xe Toute personne a droit à la liberté de pensée, de conscience, de religion, de culte...
\xf Every person has the right to freedom of thought, conscience, religion, worship...

\lx isălan
\va isӑlan
\ps n
\gf information ; nouvelles
\ge information; news
\ph [isəlan]
\di Tawallammat T-an-Mali
\gvf information
\gve information
\sm 1 Renseignements, connaissances communiquées ou obtenues, dont le droit d'accès est garanti.
\ms 1
\xv Ălxoriyyӑt wa n-iji n-isӑlan d-ajӑraw n-isӑlan ija fӑlla-sӑn almud, әḍmanӑn daɣ.
\xe La liberté de presse et le droit à l'information sont également garantis.
\xf Freedom of the press and the right to information are also guaranteed.

\lx ăhənzazăɣ
\va ӑhәnzazӑɣ
\ps n
\gf environnement
\ge environment
\ph [əhənzazəɣ]
\di Tawallammat T-an-Mali
\gvf environnement
\gve environment
\sm 1 Ensemble des conditions naturelles et culturelles qui constituent le cadre de vie des êtres humains, dont la protection est un devoir.
\ms 1
\xv Hak ӑwadәm ikf’ee ӑlxaqq tamәzzuɣt tәɣlalӑt, dӑɣ-ӑhәnzazӑɣ šӑddiijӑn.
\xe Toute personne a droit à un environnement sain.
\xf Every person has the right to a healthy environment.

\lx tajbəst
\va tajbәst
\ps n
\gf défense
\ge defense
\ph [taʒbəst]
\di Tawallammat T-an-Mali
\gvf défense
\gve defense
\sm 1 Action de protéger, de défendre un pays, ses institutions et sa population contre une agression.
\ms 1
\xv Tajbәst dӑɣ-taggaẓt n-ӑddӑwlӑt tәlzam ӑggӑddӑwlӑt a ӑmoos.
\xe La défense de la patrie est un devoir pour tout citoyen.
\xf The defense of the homeland is a duty for every citizen.
\sy taggaẓt

\lx ălmal
\va ӑlmal
\ps n
\gf bien ; richesse ; finance ; propriété
\ge property; wealth; finance
\ph [əlmal]
\di Tawallammat T-an-Mali
\gvf bien
\gve property
\sm 1 Ce qui a une valeur économique et peut être possédé, en particulier les biens publics appartenant à l'État.
\ms 1
\xv ...ilzam-t daɣ semɣar d-taggaẓt n-ӑlmal wa n-ӑddӑwlӑt.
\xe ...il doit aussi respecter et protéger le bien public.
\xf ...he must also respect and protect public property.
\sy terše

\lx tawalt
\ps n
\gf parole ; langue
\ge word; language
\ph [tawalt]
\di Tawallammat T-an-Mali
\gvf langue
\gve language
\sm 1 Système de signes vocaux et graphiques utilisé par une communauté pour la communication.
\ms 1
\xv Tawalen n-ӑddӑwlӑt ӑmoosnӑt әntӑnӑteḍ a issәbdӑd ӑlxәkum...
\xe Les langues nationales sont les langues établies par le gouvernement...
\xf The national languages are the languages established by the government...

\lx isəm
\va isәm
\ps n
\gf nom
\ge name; noun
\ph [isəm]
\di Tawallammat T-an-Mali
\gvf nom
\gve noun
\sm 1 Mot qui sert à désigner une personne, un animal, une chose concrète ou abstraite.
\ms 1
\xv 2-2- Isəm (Nom)
\xe 2-2- Nom
\xf 2-2- Noun

\lx tartit
\ps n
\gf unité ; souveraineté
\ge unity; sovereignty
\ph [tartit]
\di Tawallammat T-an-Mali
\gvf unité
\gve unity
\sm Le caractère d'un État qui n'est soumis à aucune puissance supérieure ; le fait de former un tout cohérent.
\ms 1
\xv Tәjjaš erkӑwӑl n-taggaẓt n-әllәllu d-tartit n-ӑddӑwlӑt.
\xe Elle réaffirme le principe de la protection de l'indépendance et de l'unité de l'État.
\xf It reaffirms the principle of the protection of the independence and unity of the State.
\sy tămonnit

\lx ăttarex
\va ӑttarex
\ps n
\gf histoire
\ge history
\ph [ətːarex]
\di Tawallammat T-an-Mali
\gvf histoire
\gve history
\sm L'ensemble des événements passés d'une nation ou d'un peuple.
\ms 1
\xv Ăsiihӑlӑylӑy-tӑt ӑttarex-net wa dd-tokӑy a ilan afḍӑn n-iwәtyan d-timәttawen ti dd-tәzjӑr.
\xe Fière de son histoire qui a connu la grandeur des empires et des peuples qu'elle a abrités.
\xf Proud of its history which has known the greatness of the empires and peoples it has sheltered.

\lx afḍăn
\va afḍӑn
\ps n
\gf grandeur ; valeur
\ge greatness; value
\ph [afɖən]
\di Tawallammat T-an-Mali
\gvf grandeur
\gve greatness
\sm Qualité de ce qui est grand, important, ou de grande valeur.
\ms 1
\xv ...a ilan afḍӑn n-iwәtyan d-timәttawen ti dd-tәzjӑr.
\xe ...qui a connu la grandeur des empires et des peuples qu'elle a abrités.
\xf ...which has known the greatness of the empires and peoples it has sheltered.

\lx iwətyan
\va iwәtyan
\ps n
\gf années
\ge years
\ph [iwətjan]
\di Tawallammat T-an-Mali
\gvf années
\gve years
\sm Période de douze mois.
\ms 1
\xv Dӑggӑddӑwlӑt ɣәrәd wi әlanen 18 iwәtyan tәkkәd afӑlla, әddooben ad-әtwәɣrәn i-tadhәlt n-kӑl-әlɣәṣkәr.
\xe Tous les citoyens qui ont 18 ans et plus peuvent être appelés au service militaire.
\xf All citizens who are 18 years and older may be called for military service.
\an išilan

\lx timəttawen
\va timәttawen
\ps n
\gf peuples ; nations
\ge peoples; nations
\ph [timətːawen]
\di Tawallammat T-an-Mali
\gvf peuples
\gve peoples
\sm Pluriel de tamətte; ensemble de communautés humaines.
\ms 1
\xv ...d-ansәmɣar n-ӑlɣadatӑn jer-timәttawen ti ӑheerӑjnen ašӑl-i-dӑɣ hakd ḍarӑt-a-wa.
\xe ...et le respect des coutumes entre les peuples qui ont coexisté jusqu'à ce jour et au-delà.
\xf ...and the respect for customs among the peoples who have coexisted to this day and beyond.

\lx anməṭṭaf
\va anmәṭṭaf
\ps n
\gf unité ; union
\ge unity; union
\ph [anmətˤːaf]
\di Tawallammat T-an-Mali
\gvf unité
\gve unity
\sm Le fait de former un tout cohérent et solidaire.
\ms 1
\xv Tӑmoos imәkkusa n-tikәbbulen dd-әbnanen fӑll-anmәṭṭaf d-anmәrh.
\xe Elle est le fruit de communautés construites sur l'unité et la paix.
\xf It is the fruit of communities built on unity and peace.
\sy tartit

\lx anmərh
\va anmәrh
\ps n
\gf paix
\ge peace
\ph [anmərh]
\di Tawallammat T-an-Mali
\gvf paix
\gve peace
\sm État de tranquillité, de concorde, absence de conflit.
\ms 1
\xv Tӑmoos imәkkusa n-tikәbbulen dd-әbnanen fӑll-anmәṭṭaf d-anmәrh.
\xe Elle est le fruit de communautés construites sur l'unité et la paix.
\xf It is the fruit of communities built on unity and peace.
\sy tălawit
\an akənnas

\lx ansəmɣar
\va ansәmɣar
\ps n
\gf respect
\ge respect
\ph [ansəmɣar]
\di Tawallammat T-an-Mali
\gvf respect
\gve respect
\sm Sentiment de considération envers quelqu'un ou quelque chose.
\ms 1
\xv ...d-ansәmɣar n-ӑlɣadatӑn jer-timәttawen.
\xe ...et le respect des coutumes entre les peuples.
\xf ...and the respect for customs among the peoples.

\lx ălɣadatăn
\va ӑlɣadatӑn
\ps n
\gf coutumes ; traditions
\ge customs; traditions
\ph [əlɣadatən]
\di Tawallammat T-an-Mali
\gvf coutumes
\gve customs
\sm Manières d'agir et de penser transmises de génération en génération au sein d'un groupe.
\ms 1
\xv ...d-ansәmɣar n-ӑlɣadatӑn jer-timәttawen.
\xe ...et le respect des coutumes entre les peuples.
\xf ...and the respect for customs among the peoples.

\lx tunfast
\ps n
\gf âme ; vie
\ge soul; life
\ph [tunfast]
\di Tawallammat T-an-Mali
\gvf vie
\gve life
\sm Principe de vie ; existence.
\ms 1
\xv Tәlkam i-әnniyӑt n-wi әkfӑnen tunfast-nӑsӑn ujӑyӑn s-atwәkukәl ɣur-ӑnnӑṣara.
\xe Elle répond à l'aspiration de ceux qui ont donné leur vie en refusant la soumission aux colonisateurs.
\xf It responds to the aspiration of those who gave their lives refusing submission to the colonizers.
\sy tămudre
\an taməttant

\lx imawaynən
\va imawaynәn
\ps n
\gf martyrs
\ge martyrs
\ph [imawajnən]
\di Tawallammat T-an-Mali
\gvf martyrs
\gve martyrs
\sm Personnes qui ont souffert la mort pour la défense d'une cause.
\ms 1
\xv ...d-әnniyӑt n-imawaynӑn wi dd-әssәɣsӑlnen ӑlxoriyyat.
\xe ...et à l'aspiration des martyrs qui ont conquis la liberté.
\xf ...and to the aspiration of the martyrs who won freedom.

\lx asəməl
\va asәmәl
\ps n
\gf établissement ; fondation
\ge establishment; foundation
\ph [asəməl]
\di Tawallammat T-an-Mali
\gvf établissement
\gve establishment
\sm Action de fonder, de créer une institution ou un État.
\ms 1
\xv ...i-taggaẓt d-asәmәl n-ӑddӑwlәt dӑɣ-ӑddewӑn ӑddinӑt әẓlaynen ihӑnayӑn.
\xe ...pour la protection et l'établissement de l'État dans un cadre pluraliste.
\xf ...for the protection and establishment of the State in a pluralistic framework.

\lx aɣăšad
\va aɣӑšad
\ps n
\gf crime ; injustice ; forfaiture
\ge crime; injustice; wrongdoing
\ph [aɣəʃad]
\di Tawallammat T-an-Mali
\gvf crime
\gve crime
\sm Acte illégal grave, puni par la loi.
\ms 1
\xv Ăwadәm tәwӑr torda a ӑmoos, izzilzӑm ӑlxaqq ad-wӑr-imos a iɣšadӑn.
\xe Toute personne est présumée innocente jusqu'à ce que sa culpabilité soit établie.
\xf Every person is presumed innocent until proven guilty.
\sy abăkkaḍ
\an iqqud

\lx temăkšit
\va temӑkšit
\ps n
\gf corruption
\ge corruption
\ph [teməkʃit]
\di Tawallammat T-an-Mali
\gvf corruption
\gve corruption
\sm Utilisation abusive d'un pouvoir ou d'une fonction à des fins privées.
\ms 1
\xv ...tәjbas fӑll-tijawt n-timašalen ɣәrәd ti әdhalnen ukәs n-temӑkšit d-temӑkrӑḍt.
\xe ...elle s'engage à mener toutes les actions visant à éliminer la corruption et la délinquance.
\xf ...it commits to carrying out all actions aimed at eliminating corruption and delinquency.
\an sărho

\lx tănfo
\va tӑnfo
\ps n
\gf intérêt ; bienfait
\ge interest; benefit
\ph [tənfo]
\di Tawallammat T-an-Mali
\gvf intérêt
\gve interest
\sm Ce qui importe, ce qui est avantageux pour une personne ou une collectivité.
\ms 1
\xv Hak ӑggӑddӑwlӑt tәlzam-t tajbәst i-tӑnfo n-tamәtte.
\xe Tout citoyen a le devoir de défendre l'intérêt de la communauté.
\xf Every citizen has the duty to defend the community's interest.

\lx ahăroj
\va ahӑroj
\ps n
\gf dialogue
\ge dialogue
\ph [ahəroʒ]
\di Tawallammat T-an-Mali
\gvf dialogue
\gve dialogue
\sm Entretien entre deux ou plusieurs personnes en vue d'aboutir à un accord.
\ms 1
\xv ...almud n-tartit dӑɣ-tamәzzuɣt d-anmәṭṭaf dӑɣ-ahӑroj.
\xe ...l'apprentissage de l'unité dans la vie et de l'union dans le dialogue.
\xf ...learning unity in life and union in dialogue.
\sy tanmənnakt

\lx tanmənnakt
\va tanmәnnakt
\ps n
\gf consultation ; accord ; concertation
\ge consultation; agreement
\ph [tanmənːakt]
\di Tawallammat T-an-Mali
\gvf consultation
\gve consultation
\sm Action de délibérer à plusieurs sur une question.
\ms 1
\xv Il a isanayӑn mәnistӑrӑn wi hӑḍnen, ḍarӑt-tanmәnnakt d- ӑmizӑr n-mәnistӑrӑn.
\xe Il nomme les autres ministres, après consultation avec le Premier ministre.
\xf He appoints the other ministers, after consultation with the Prime Minister.
\sy ahăroj

\lx anəzjum
\va anәzjum
\ps n
\gf devise ; slogan
\ge motto; slogan
\ph [anəzʒum]
\di Tawallammat T-an-Mali
\gvf devise
\gve motto
\sm Formule brève qui exprime une pensée, un idéal, une règle de conduite.
\ms 1
\xv Anәzjum-net d-derhan-net әhan tӑmonnit-ta: “Tamәtte Iyyӑt – Ittus Iyyӑn – Erkӑwӑl Iyyӑn”.
\xe Sa devise et son aspiration sont cette unité : "Un Peuple – Un But – Une Foi".
\xf Its motto and aspiration are this unity: "One People – One Goal – One Faith".

\lx ăḍḍamin
\va ӑḍḍamin
\ps n
\gf garant
\ge guarantor
\ph [əɖːamin]
\di Tawallammat T-an-Mali
\gvf garant
\gve guarantor
\sm Personne ou institution qui assure le respect d'un engagement, d'une loi ou d'un droit.
\ms 1
\xv Ămoos ӑḍḍamin n-tartit n-ӑddӑwlӑt.
\xe Il est le garant de l'unité nationale.
\xf He is the guarantor of national unity.
\sy magaẓ

\lx tălawit
\va tӑlawit
\ps n
\gf paix ; quiétude
\ge peace; quietude
\ph [təlawit]
\di Tawallammat T-an-Mali
\gvf paix
\gve peace
\sm État de concorde et d'harmonie sociale.
\ms 1
\xv Tәjbas fӑll-uẓәj n-tӑlawit n-dӑggadәm.
\xe Elle s'engage pour la promotion de la paix humaine.
\xf It commits to the promotion of human peace.
\sy anmərh
\an akənnas

\lx demokrasi
\ps n
\gf démocratie
\ge democracy
\ph [demokrasi]
\di Tawallammat T-an-Mali
\gvf démocratie
\gve democracy
\sm 1 Système politique dans lequel la souveraineté émane du peuple.
\ms 1
\xv Tәssilmӑd derhan-net n-asәssuf n-tisәɣsal n-demokrasi ta dd-torӑw tanӑkra ta tәjӑt dӑɣ-26 dӑɣ-Maris 1991.
\xe Elle proclame son attachement à la consolidation des acquis de la démocratie issue de la révolution du 26 mars 1991.
\xf It proclaims its commitment to consolidating the gains of the democracy resulting from the revolution of March 26, 1991.

\lx tanăkra
\va tanӑkra
\ps n
\gf révolution ; soulèvement
\ge revolution; uprising
\ph [tanəkra]
\di Tawallammat T-an-Mali
\gvf révolution
\gve revolution
\sm 1 Changement brusque et violent dans la structure politique et sociale d'un État.
\ms 1
\xv ...tanӑkra ta tәjӑt dӑɣ-26 dӑɣ-Maris 1991...
\xe ...la révolution du 26 mars 1991...
\xf ...the revolution of March 26, 1991...

\lx akăros
\va akӑros
\ps n
\gf ordre ; chemin ; voie
\ge order; path; way
\ph [akəros]
\di Tawallammat T-an-Mali
\gvf ordre
\gve order
\sm 1 État régulier, organisé ; la voie normale des choses.
\ms 1
\xv ...d-uẓәj n-әnniyӑt n-uɣәl dӑɣ-akӑros ӑynayӑn wa әddorhӑnӑn kӑl-Mali.
\xe ...et à la promotion de la volonté de retour à un ordre nouveau auquel les Maliens aspirent.
\xf ...and to the promotion of the will to return to a new order to which Malians aspire.

\lx ăddewăn
\va ӑddewӑn
\ps n
\gf cadre ; contexte
\ge framework; context
\ph [ədːewən]
\di Tawallammat T-an-Mali
\gvf cadre
\gve framework
\sm 1 Contexte ou structure dans lequel un événement ou une action se déroule.
\ms 1
\xv ...d-asәmәl n-ӑddӑwlәt dӑɣ-ӑddewӑn ӑddinӑt әẓlaynen ihӑnayӑn.
\xe ...et l'établissement de l'État dans un cadre pluraliste.
\xf ...and the establishment of the State in a pluralistic framework.

\lx taggaẓt
\ps n
\gf protection ; défense ; sauvegarde
\ge protection; defense; safeguarding
\ph [tagːazˤt]
\di Tawallammat T-an-Mali
\gvf protection
\gve protection
\sm 1 Action de protéger, de mettre à l'abri d'un danger ou d'un mal.
\ms 1
\xv Tәjjaš erkӑwӑl n-taggaẓt n-әllәllu d-tartit n-ӑddӑwlәt.
\xe Elle réaffirme le principe de la protection de l'indépendance et de l'unité de l'État.
\xf It reaffirms the principle of the protection of the independence and unity of the State.
\sy tajbəst

\lx әllәllu
\va əlləllu
\ps n
\gf indépendance ; souveraineté
\ge independence; sovereignty
\ph [əlːəlːu]
\di Tawallammat T-an-Mali
\gvf indépendance
\gve independence
\sm 1 Situation d'une nation qui ne dépend d'aucune autre sur le plan politique.
\ms 1
\xv Tәjjaš erkӑwӑl n-taggaẓt n-әllәllu d-tartit n-ӑddӑwlәt.
\xe Elle réaffirme le principe de la protection de l'indépendance et de l'unité de l'État.
\xf It reaffirms the principle of the protection of the independence and unity of the State.
\sy ălxoriyyăt

\lx ajăraw
\va ajӑraw
\ps n
\gf accès ; droit
\ge access; right
\ph [aʒəraw]
\di Tawallammat T-an-Mali
\gvf accès
\gve access
\sm 1 Possibilité d'accéder à quelque chose, d'en bénéficier ; droit.
\ms 1
\xv ...d-ajӑraw i-hak ӑwadәm i-alkum i-ӑddin-net dӑɣ-ӑddӑwlәt.
\xe ...et l'accès de toute personne à la participation à la vie publique.
\xf ...and the access of every person to participation in public life.
\sy ălxaqq

\lx timašalen
\ps n
\gf actions ; affaires ; mesures
\ge actions; affairs; measures
\ph [timaʃalen]
\di Tawallammat T-an-Mali
\gvf actions
\gve actions
\sm 1 Ensemble d'actes ou de mesures prises pour atteindre un but.
\ms 1
\xv Tәjbas fӑll-tijawt n-timašalen ɣәrәd ti әdhalnen ukәs n-temӑkšit.
\xe Elle s'engage à mener toutes les actions visant à éliminer la corruption.
\xf It commits to carrying out all actions aimed at eliminating corruption.

\lx ukəs
\va ukәs
\ps n
\gf élimination ; suppression ; retrait
\ge elimination; removal
\ph [ukəs]
\di Tawallammat T-an-Mali
\gvf élimination
\gve elimination
\sm 1 Action de faire disparaître, de supprimer.
\ms 1
\xv ...ukәs n-temӑkšit d-temӑkrӑḍt...
\xe ...l'élimination de la corruption et de la délinquance...
\xf ...the elimination of corruption and delinquency...

\lx temăkrăḍt
\va temӑkrӑḍt
\ps n
\gf délinquance ; criminalité
\ge delinquency; crime
\ph [teməkraɖt]
\di Tawallammat T-an-Mali
\gvf délinquance
\gve delinquency
\sm 1 Ensemble des infractions à la loi pénale.
\ms 1
\xv ...ukәs n-temӑkšit d-temӑkrӑḍt...
\xe ...l'élimination de la corruption et de la délinquance...
\xf ...the elimination of corruption and delinquency...
\sy aɣăšad

\lx sărho
\va sӑrho
\ps n
\gf bonne gouvernance ; droiture ; justice
\ge good governance; righteousness; justice
\ph [sər̥o]
\di Tawallammat T-an-Mali
\gvf bonne gouvernance
\gve good governance
\sm 1 Manière de gouverner juste, transparente et responsable.
\ms 1
\xv ...d-uẓәj n-sӑrho n-tәmmәnәya.
\xe ...et la promotion de la bonne gouvernance.
\xf ...and the promotion of good governance.
\an temăkšit

\lx təmmənəya
\va tәmmәnәya
\ps n
\gf pouvoir ; autorité
\ge power; authority
\ph [təmːənəja]
\di Tawallammat T-an-Mali
\gvf pouvoir
\gve power
\sm 1 Capacité d'imposer sa volonté à d'autres ; autorité politique.
\ms 1
\xv ...d-uẓәj n-sӑrho n-tәmmәnәya.
\xe ...et la promotion de la bonne gouvernance.
\xf ...and the promotion of good governance.
\sy inaxkim

\lx nasyon
\ps n
\gf nation
\ge nation
\ph [nasjon]
\di Tawallammat T-an-Mali
\gvf nation
\gve nation
\sm 1 Communauté humaine, généralement établie sur un même territoire, qui possède une unité historique, linguistique, culturelle, économique.
\ms 1
\xv Tәbbuubba temӑrt n-Nasyon zini ta tәjӑt fӑll-ӑlxaqqӑn n-ӑggadәm.
\xe Elle souscrit à la Déclaration Universelle des Droits de l'Homme.
\xf It subscribes to the Universal Declaration of Human Rights.
\sy tamətte

\lx tiḍeḍen
\ps n
\gf femmes
\ge women
\ph [tiɖeɖen]
\di Tawallammat T-an-Mali
\gvf femmes
\gve women
\sm 1 Pluriel de tamăḍt; personnes de sexe féminin.
\ms 1
\xv Tәjbas fӑll-aḍӑman n-ӑlxaqqӑn n-ӑggadәm, hullan wi n-tiḍeḍen d-inaɣyabӑn.
\xe Elle s'engage à garantir les droits de l'homme, en particulier ceux des femmes et des enfants.
\xf It commits to guaranteeing human rights, especially those of women and children.
\an maddən

\lx inaɣyabăn
\va inaɣyabӑn
\ps n
\gf enfants
\ge children
\ph [inaɣjabən]
\di Tawallammat T-an-Mali
\gvf enfants
\gve children
\sm 1 Personnes qui n'ont pas atteint l'âge de la majorité.
\ms 1
\xv ...hullan wi n-tiḍeḍen d-inaɣyabӑn...
\xe ...en particulier ceux des femmes et des enfants...
\xf ...especially those of women and children...

\lx tinmərḍuten
\va tinmәrḍuten
\ps n
\gf traités ; accords
\ge treaties; agreements
\ph [tinmərɖuten]
\di Tawallammat T-an-Mali
\gvf traités
\gve treaties
\sm 1 Accords conclus par écrit entre des États et régis par le droit international.
\ms 1
\xv ...wi fӑll-әjӑnӑt tinmәrḍuten jer-әddәwәlӑn, iqbӑl-tӑn Mali.
\xe ...qui sont l'objet de traités internationaux auxquels le Mali a souscrit.
\xf ...which are the subject of international treaties to which Mali has subscribed.

\lx aləɣu
\va alәɣu
\ps n
\gf appel ; proclamation
\ge call; appeal; proclamation
\ph [aləɣu]
\di Tawallammat T-an-Mali
\gvf appel
\gve call
\sm 1 Action de s'adresser solennellement à quelqu'un ou à un groupe.
\ms 1
\xv Tәqqal dӑɣ-alәɣu n-tajbәst i-asәɣsәl n-tartit n-Afriyәya.
\xe Elle répond à l'appel à la défense pour la réalisation de l'unité africaine.
\xf It responds to the call for the defense for the achievement of African unity.

\lx asəɣsəl
\va asәɣsәl
\ps n
\gf réalisation ; accomplissement
\ge achievement; realization; accomplishment
\ph [asəɣsəl]
\di Tawallammat T-an-Mali
\gvf réalisation
\gve achievement
\sm 1 Action de rendre réel, d'accomplir un projet, un idéal.
\ms 1
\xv ...i-asәɣsәl n-tartit n-Afriyәya...
\xe ...pour la réalisation de l'unité africaine...
\xf ...for the achievement of African unity...

\lx afriyəya
\va afriyәya
\ps n.prop
\gf Afrique
\ge Africa
\ph [afrijəja]
\di Tawallammat T-an-Mali
\gvf Afrique
\gve Africa
\sm 1 Le continent africain.
\ms 1
\xv ...i-asәɣsәl n-tartit n-Afriyәya...
\xe ...pour la réalisation de l'unité africaine...
\xf ...for the achievement of African unity...

\lx asətbat
\va asәtbat
\ps n
\gf renforcement ; consolidation
\ge strengthening; consolidation
\ph [asətbat]
\di Tawallammat T-an-Mali
\gvf renforcement
\gve strengthening
\sm 1 Action de rendre plus fort, plus solide.
\ms 1
\xv ...d-asәtbat n-ӑlɣafyӑt tifәllay n-Afriqәya...
\xe ...et le renforcement de la sécurité et du bien-être en Afrique...
\xf ...and the strengthening of security and well-being in Africa...

\lx əlfəṣəl
\va әlfәṣәl
\ps n
\gf article (de loi)
\ge article (of law)
\ph [əlfəsˤəl]
\di Tawallammat T-an-Mali
\gvf article
\gve article
\sm 1 Division d'une loi, d'un traité ou d'un règlement, portant un numéro d'ordre.
\ms 1
\xv Ǝlfәṣәl 1 : Kӑl-Mali ɣәrәd, as dd-tiiwәn oogdӑhӑn dӑɣ-ӑlxoriyyӑt d-ӑlxaqqӑn.
\xe Article 1 : Tous les Maliens naissent et demeurent libres et égaux en droits.
\xf Article 1: All Malians are born and remain free and equal in rights.

\lx tawset
\va Tadghaq
\ps n
\gf origine ; race ; espèce
\ge origin; race; species
\ph [tawset]
\di Tawallammat T-an-Mali
\gvf origine
\gve origin
\sm 1 Principe, commencement, source de quelque chose ou de quelqu'un.
\ms 1
\xv ...wӑrt-illa a-s tӑn-ӑẓiimẓlӑynӑt tiwsaten-nӑsӑn...
\xe ...sans distinction de leurs origines...
\xf ...without distinction of their origins...
\sy alăṣăl

\lx ini
\ps n
\gf couleur
\ge color
\ph [ini]
\di Tawallammat T-an-Mali
\gvf couleur
\gve color
\sm 1 Caractère d'une surface qui résulte de la manière dont elle réfléchit ou absorbe la lumière.
\ms 1
\xv ...wӑla initӑn-nӑsӑn...
\xe ...ni de leurs couleurs...
\xf ...nor their colors...

\lx ahănay
\va ahӑnay
\ps n
\gf opinion ; avis ; pensée
\ge opinion; view; thought
\ph [ahənaj]
\di Tawallammat T-an-Mali
\gvf opinion
\gve opinion
\sm 1 Manière de penser, de juger ; avis personnel.
\ms 1
\xv ...wӑla ihӑnayӑn-nӑsӑn dӑɣ-folitik.
\xe ...ni de leurs opinions politiques.
\xf ...nor their political opinions.

\lx folitik
\ps n
\gf politique
\ge politics
\ph [folitik]
\di Tawallammat T-an-Mali
\gvf politique
\gve politics
\sm 1 Art et pratique du gouvernement des sociétés humaines.
\ms 1
\xv ...wӑla ihӑnayӑn-nӑsӑn dӑɣ-folitik.
\xe ...ni de leurs opinions politiques.
\xf ...nor their political opinions.

\lx atwigəẓ
\va atwigәẓ
\ps n
\gf protection
\ge protection
\ph [atwigəzˤ]
\di Tawallammat T-an-Mali
\gvf protection
\gve protection
\sm 1 Action de défendre quelqu'un ou quelque chose contre un danger, un risque.
\ms 1
\xv Hak ӑwadәm ila ӑlxaqq n-tӑmudre d-ӑlɣafyӑt d-atwigәẓ n-taɣәssa-net s-aɣrud.
\xe Toute personne a droit à la vie, à la sécurité et à la protection de son intégrité physique.
\xf Every person has the right to life, security, and the protection of their physical integrity.
\sy taggaẓt

\lx əkkəlu
\va әkkәlu
\ps n
\gf esclavage
\ge slavery
\ph [əkːəlu]
\di Tawallammat T-an-Mali
\gvf esclavage
\gve slavery
\sm 1 État, condition de la personne qui est sous la domination absolue d'un maître.
\ms 1
\xv Wӑr-t-illa ere tәlzam tӑhәnšareḍt, wӑla әkkәlu...
\xe Nul ne sera soumis à la servitude, ni à l'esclavage...
\xf No one shall be subjected to servitude, nor to slavery...
\sy tăhănšareḍt
\an ălxoriyyăt

\lx talɣa
\ps n
\gf forme ; manière ; traitement ; torture
\ge form; manner; treatment; torture
\ph [talɣa]
\di Tawallammat T-an-Mali
\gvf torture
\gve torture
\sm 1 Action d'infliger une douleur physique ou morale aiguë et délibérée.
\ms 1
\xv ...wӑla talɣiwen fӑlla-s әkkasnen sӑrho, ӑsikӑrakӑḍnӑt-t.
\xe ...ni à la torture, ni à des peines ou traitements inhumains.
\xf ...nor to torture, nor to inhuman punishments or treatments.

\lx azəjor
\va azәjor
\ps n
\gf exil ; sortie
\ge exile; departure
\ph [azəʒor]
\di Tawallammat T-an-Mali
\gvf exil
\gve exile
\sm 1 Fait d'être expulsé ou de vivre hors de sa patrie.
\ms 1
\xv Wӑr-t-illa itakӑraḍ azӑjor n-ӑddӑwlӑt-net.
\xe Nul ne peut être contraint à l'exil.
\xf No one may be forced into exile.

\lx taməzzoɣt
\va tamәzzoɣt
\ps n
\gf vie en société ; cohabitation
\ge social life; cohabitation
\ph [taməzːoɣt]
\di Tawallammat T-an-Mali
\gvf vie en société
\gve social life
\sm 1 Ensemble des relations qu'entretiennent les individus au sein d'une communauté.
\ms 1
\xv Adubәn d-ӑlɣӑyal i ӑmoosnen ӑssas n-tamәzzoɣt dӑɣ-tamәtte...
\xe Le mariage et la famille sont la base de la vie en société...
\xf Marriage and family are the basis of life in society...

\lx asəlmad
\va asәlmad
\ps n
\gf enseignement ; formation
\ge teaching; training
\ph [asəlmad]
\di Tawallammat T-an-Mali
\gvf formation
\gve training
\sm 1 Action de transmettre des connaissances et des compétences.
\ms 1
\xv Teɣӑre, asәlmad n-әššәɣәl... ӑmoosӑn ӑlxaqqӑn әtbatnen i-ӑggadәm...
\xe L'éducation, la formation professionnelle... sont des droits établis pour l'être humain...
\xf Education, vocational training... are established rights for the human being...
\sy teɣăre

\lx əzazăɣ
\va әzazӑɣ
\ps n
\gf domicile ; logement ; résidence
\ge domicile; housing; residence
\ph [əzazəɣ]
\di Tawallammat T-an-Mali
\gvf domicile
\gve domicile
\sm 1 Lieu où une personne a son principal établissement.
\ms 1
\xv Ăzazӑɣ, edӑgg n-ӑwadәm, talɣa dd-tәqqalӑt ӑwadәm d-ӑlɣӑyal-net...
\xe Le domicile, la résidence, la correspondance et la vie privée sont inviolables.
\xf The home, residence, correspondence, and private life are inviolable.

\lx əssexət
\va әssexәt
\ps n
\gf santé
\ge health
\ph [əsːexət]
\di Tawallammat T-an-Mali
\gvf santé
\gve health
\sm 1 État de complet bien-être physique, mental et social.
\ms 1
\xv Teɣӑre... ӑssexӑt, atwigәẓ, isudar d-ajӑraw n-aman, ӑmoosӑn ӑlxaqqӑn...
\xe L'éducation... la santé, la protection, les soins et l'accès à l'eau sont des droits...
\xf Education... health, protection, care, and access to water are rights...

\lx aman
\ps n
\gf eau
\ge water
\ph [aman]
\di Tawallammat T-an-Mali
\gvf eau
\gve water
\sm 1 Liquide transparent, inodore et sans saveur, essentiel à la vie.
\ms 1
\xv ...isudar d-ajӑraw n-aman, ӑmoosӑn ӑlxaqqӑn әtbatnen i-ӑggadәm...
\xe ...les soins et l'accès à l'eau sont des droits établis pour l'être humain...
\xf ...care and access to water are established rights for the human being...

\lx ăggăddăwlăt
\va ӑggӑddӑwlӑt
\ps n
\gf citoyen
\ge citizen
\ph [əgːədːəwlət]
\di Tawallammat T-an-Mali
\gvf citoyen
\gve citizen
\sm 1 Personne qui relève de l'État, qui jouit des droits civiques et politiques et doit accomplir des devoirs.
\ms 1
\xv Tajbәst dӑɣ-taggaẓt n-ӑddӑwlӑt tәlzam ӑggӑddӑwlӑt a ӑmoos.
\xe La défense de la patrie est un devoir pour tout citoyen.
\xf The defense of the homeland is a duty for every citizen.

\lx sendika
\ps n
\gf syndicat
\ge union
\ph [sendika]
\di Tawallammat T-an-Mali
\gvf syndicat
\gve union
\sm 1 Association de personnes dont l'objet est la défense d'intérêts professionnels communs.
\ms 1
\xv Ălxoriyyӑt wa n-ujәš n-sendika tәḍman.
\xe La liberté syndicale est garantie.
\xf Freedom of association for unions is guaranteed.

\lx gəref
\va gәref
\ps n
\gf grève
\ge strike
\ph [gəref]
\di Tawallammat T-an-Mali
\gvf grève
\gve strike
\sm 1 Cessation collective et concertée du travail par des salariés en vue d'appuyer des revendications professionnelles.
\ms 1
\xv Ălxaqq wa n-tijawt n-gәref (aɣӑram dӑɣ- әššәɣәl), iḍman.
\xe Le droit de grève est garanti.
\xf The right to strike is guaranteed.

\lx ăššarika
\va ӑššarika
\ps n
\gf association ; société
\ge association; society
\ph [əʃːarika]
\di Tawallammat T-an-Mali
\gvf association
\gve association
\sm 1 Groupement de personnes volontairement réunies pour un objet déterminé.
\ms 1
\xv Ălxoriyyӑt wa n-tijawt n-ӑššarika, iḍman-t ӑššӑreɣa.
\xe La liberté d'association est garantie par la loi.
\xf Freedom of association is guaranteed by law.

\lx tadhəlt
\va tadhәlt
\ps n
\gf service
\ge service
\ph [tadhəlt]
\di Tawallammat T-an-Mali
\gvf service
\gve service
\sm 1 Action de servir, de s'acquitter d'une obligation, notamment le service militaire.
\ms 1
\xv ...әddooben ad-әtwәɣrәn i-tadhәlt n-kӑl-әlɣәṣkәr i- taggaẓt n-ӑddӑwlӑt.
\xe ...peuvent être appelés au service militaire pour la défense de la patrie.
\xf ...may be called to military service for the defense of the homeland.

\lx timẓal
\ps n
\gf impôts ; taxes ; droits
\ge taxes; duties
\ph [timzˤal]
\di Tawallammat T-an-Mali
\gvf impôts
\gve taxes
\sm 1 Prélèvements obligatoires effectués par l'État pour subvenir aux dépenses publiques.
\ms 1
\xv Hak ӑggӑddӑwlӑt ilzam-t iji n-a-wa t-ӑswӑr ӑššӑreɣa, hullan timẓal n-tiwse d-takәstӑn.
\xe Tout citoyen doit s'acquitter de ses obligations fiscales, notamment les impôts et les taxes.
\xf Every citizen must fulfill their fiscal obligations, notably duties and taxes.
\sy takəstăn

\lx takəstăn
\va takәstӑn
\ps n
\gf taxes ; contributions
\ge taxes; contributions
\ph [takəstən]
\di Tawallammat T-an-Mali
\gvf taxes
\gve taxes
\sm 1 Prélèvements pécuniaires requis des particuliers par voie d'autorité pour contribuer aux dépenses publiques.
\ms 1
\xv Hak ӑggӑddӑwlӑt ilzam-t iji n-a-wa t-ӑswӑr ӑššӑreɣa, hullan timẓal n-tiwse d-takәstӑn.
\xe Tout citoyen doit s'acquitter de ses obligations fiscales, notamment les impôts et les taxes.
\xf Every citizen must fulfill their fiscal obligations, notably duties and taxes.
\sy timẓal

\lx tămonnit
\va tӑmonnit
\ps n
\gf unité
\ge unity
\ph [təmonːit]
\di Tawallammat T-an-Mali
\gvf unité
\gve unity
\sm 1 Caractère de ce qui est un, indivisible ; cohésion d'un groupe.
\ms 1
\xv Anәzjum-net d-derhan-net әhan tӑmonnit-ta: “Tamәtte Iyyӑt – Ittus Iyyӑn – Erkӑwӑl Iyyӑn”.
\xe Sa devise et son aspiration sont cette unité : "Un Peuple – Un But – Une Foi".
\xf Its motto and aspiration are this unity: "One People – One Goal – One Faith".
\sy tartit

\lx ălɣasim
\va ӑlɣasim
\ps n
\gf capitale
\ge capital city
\ph [əlɣasim]
\di Tawallammat T-an-Mali
\gvf capitale
\gve capital
\sm 1 Ville où siège le gouvernement d'un État.
\ms 1
\xv Ălɣasim n-ӑddӑwlӑt n-Mali Bӑmӑko.
\xe La capitale de l'État du Mali est Bamako.
\xf The capital of the State of Mali is Bamako.

\lx tuləft
\va tulәft
\ps n
\gf drapeau
\ge flag
\ph [tuləft]
\di Tawallammat T-an-Mali
\gvf drapeau
\gve flag
\sm 1 Pièce d'étoffe aux couleurs d'une nation, servant d'emblème.
\ms 1
\xv Sӑttemal-net tulәft dӑɣ-әrtayӑn initӑn kӑraḍ әjanen dӑɣ-kӑraḍӑt tiswaḍ, әɣtanen oogdӑhnӑt-ti: tӑddalӑt, tәruɣe ta n-urӑɣ d-tәšuɣe.
\xe Son emblème est le drapeau tricolore à trois bandes verticales et égales : vert, or et rouge.
\xf Its emblem is the tricolor flag with three vertical and equal bands: green, gold, and red.

\lx taɣmărt
\va taɣmӑrt
\ps n
\gf hymne
\ge hymn
\ph [taɣmərt]
\di Tawallammat T-an-Mali
\gvf hymne
\gve hymn
\sm 1 Chant solennel en l'honneur d'une nation ou d'une divinité.
\ms 1
\xv Taɣmӑrt n-Mali tӑmoos : “Mali”.
\xe L'hymne du Mali est : "Mali".
\xf The hymn of Mali is: "Mali".

\lx tadrəmt
\va tadrәmt
\ps n
\gf monnaie
\ge currency
\ph [tadrəmt]
\di Tawallammat T-an-Mali
\gvf monnaie
\gve currency
\sm 1 Unité monétaire ayant cours légal dans un pays.
\ms 1
\xv Ăššӑreɣa a isabdadӑn tadrәmt n-aẓӑẓlo-net d-sӑttemalӑn-net, әnta daɣ a isabdadӑn әmmәk wa s-tamašalӑn.
\xe La loi établit la monnaie ayant cours légal et ses symboles, et elle établit également la manière dont ils sont utilisés.
\xf The law establishes the currency with legal tender and its symbols, and it also establishes the manner in which they are used.

\lx layisite
\ps n
\gf laïcité
\ge secularism
\ph [lajisite]
\di Tawallammat T-an-Mali
\gvf laïcité
\gve secularism
\sm 1 Principe de séparation de l'État et des organisations religieuses.
\ms 1
\xv A-wa s-itawӑnna layisite (ӑttӑsrex dӑɣ-isӑlan wi n-ӑddin), wӑr-ӑnmӑšrӑy d-ӑddin.
\xe Ce qu'on appelle laïcité (séparation dans les affaires de religion), ne s'oppose pas à la religion.
\xf What is called secularism (separation in matters of religion), is not opposed to religion.
\sy ăttăsrex

\lx ăssas
\va ӑssas
\ps n
\gf base ; fondement ; principe
\ge base; foundation; principle
\ph [əsːas]
\di Tawallammat T-an-Mali
\gvf fondement
\gve foundation
\sm 1 Ce qui sert de support, de principe fondamental à quelque chose.
\ms 1
\xv Ăssasӑn n-ӑddӑwlӑt ӑmoosӑn amsәṣuhu, igdӑh, iqqud, taggaẓt d-anmәjjaš.
\xe Les fondements de l'État sont la solidarité, l'égalité, la justice, la protection et le partage.
\xf The foundations of the State are solidarity, equality, justice, protection, and sharing.
\sy erkăwăl

\lx iqqud
\ps n
\gf justice ; équité
\ge justice; equity
\ph [iqːud]
\di Tawallammat T-an-Mali
\gvf justice
\gve justice
\sm 1 Principe moral de conformité au droit ; caractère de ce qui est juste, équitable.
\ms 1
\xv Ăssasӑn n-ӑddӑwlӑt ӑmoosӑn amsәṣuhu, igdӑh, iqqud, taggaẓt d-anmәjjaš.
\xe Les fondements de l'État sont la solidarité, l'égalité, la justice, la protection et le partage.
\xf The foundations of the State are solidarity, equality, justice, protection, and sharing.
\sy sărho
\an aɣăšad

\lx ălwăkil
\va ӑlwӑkil
\ps n
\gf agent ; représentant ; mandataire
\ge agent; representative
\ph [əlwəkil]
\di Tawallammat T-an-Mali
\gvf agent
\gve agent
\sm 1 Personne qui agit pour le compte d'une autre, d'une administration.
\ms 1
\xv Wӑr-t-illa ӑlwӑkil n-ӑlxәkum, iddooben asәhhәtәl fӑll-konstitisyon meɣ ӑššӑreɣa iyyӑn ad-itatt ӑlmal n-ӑddӑwlӑt...
\xe Aucun agent du gouvernement ne peut utiliser la constitution ou une loi pour s'approprier les biens de l'État...
\xf No government agent may use the constitution or a law to appropriate State property...

\lx ălxəzəb
\va ӑlxәzәb
\ps n
\gf parti politique
\ge political party
\ph [əlxəzəb]
\di Tawallammat T-an-Mali
\gvf parti
\gve party
\sm 1 Organisation politique qui partage une idéologie commune et cherche à exercer le pouvoir.
\ms 1
\xv Ălxәzәbӑn wi n-folitik әntӑneḍ a dahhӑlnen s-asәlmad n-derhan n-timәttawen.
\xe Les partis politiques contribuent à l'éducation des aspirations du peuple.
\xf Political parties contribute to the education of the people's aspirations.

\lx wăte
\va wӑte
\ps n
\gf vote ; suffrage
\ge vote; suffrage
\ph [wəte]
\di Tawallammat T-an-Mali
\gvf vote
\gve vote
\sm 1 Acte par lequel un citoyen exprime son opinion lors d'une élection ou d'une consultation.
\ms 1
\xv Wӑte ӑsiisalӑh ӑddinӑt ɣәrәd, ӑsiisӑgdӑh-tӑn, itajj dӑɣ-takše.
\xe Le vote est universel, égal et secret.
\xf The vote is universal, equal, and secret.

\lx maddən
\va maddәn
\ps n
\gf hommes
\ge men
\ph [madːən]
\di Tawallammat T-an-Mali
\gvf hommes
\gve men
\sm 1 Pluriel de ăhaləs; personnes de sexe masculin.
\ms 1
\xv Imәwwәta, ӑmoosӑn dӑggӑddӑwlӑt n-Mali, maddәn hakd tiḍeḍen, әwwӑḍnen wӑte wi issәbdӑd ӑššӑreɣa...
\xe Sont électeurs, les citoyens maliens, hommes et femmes, ayant atteint l'âge fixé par la loi...
\xf Voters are Malian citizens, men and women, who have reached the age set by law...
\an tiḍeḍen

\lx akrəmma
\va akrәmma
\ps n
\gf partie ; portion
\ge part; portion
\ph [akrəmːa]
\di Tawallammat T-an-Mali
\gvf partie
\gve part
\sm 1 Élément d'un tout ; portion d'un territoire.
\ms 1
\xv Ălxәkum wӑr-iddobӑt ad-hin-ӑyy wӑla iyyӑn n-akrәmma n-ӑddӑwlӑt, wӑr-iddobӑt daɣ ad-ujәy s-wӑla iyyӑn dӑɣ-ӑlxaqqӑn wi t-ikfa әllәllu-net fӑlla-s.
\xe Le gouvernement ne peut céder aucune partie du territoire, ni renoncer à aucun des droits que lui confère sa souveraineté.
\xf The government may not cede any part of the territory, nor renounce any of the rights conferred upon it by its sovereignty.

\lx afănaẓ
\va afӑnaẓ
\ps n
\gf trahison
\ge treason
\ph [afənazˤ]
\di Tawallammat T-an-Mali
\gvf trahison
\gve treason
\sm 1 Crime consistant à trahir sa patrie.
\ms 1
\xv A ӑmoos afӑnaẓ n-ӑddӑwlӑt, oolӑh-as d-iji n-abӑkkaḍ ogdӑhӑn d-iji n-iman.
\xe La haute trahison est un crime imprescriptible contre le peuple.
\xf High treason is an imprescriptible crime against the people.

\lx abăkkaḍ
\va abӑkkaḍ
\ps n
\gf péché ; crime
\ge sin; crime
\ph [abəkːaɖ]
\di Tawallammat T-an-Mali
\gvf crime
\gve crime
\sm 1 Infraction très grave à la loi morale ou pénale.
\ms 1
\xv A ӑmoos afӑnaẓ n-ӑddӑwlӑt, oolӑh-as d-iji n-abӑkkaḍ ogdӑhӑn d-iji n-iman.
\xe La haute trahison est un crime imprescriptible contre le peuple.
\xf High treason is an imprescriptible crime against the people.
\sy aɣăšad

\lx tibɣar
\ps n
\gf ressources
\ge resources
\ph [tibɣar]
\di Tawallammat T-an-Mali
\gvf ressources
\gve resources
\sm 1 Ensemble des moyens (naturels, financiers, humains) dont dispose un pays.
\ms 1
\xv ...a-wa dd-iqqalӑn ӑlmal n-ӑddӑwlӑt d-tibɣar ti n-ӑrori n-ӑkall.
\xe ...ce qui concerne les biens de l'État et les ressources du sous-sol.
\xf ...what concerns State property and subsoil resources.

\lx emənnəɣəf
\va emәnnәɣәf
\ps n
\gf chef ; président
\ge chief; head; president
\ph [emənːəɣəf]
\di Tawallammat T-an-Mali
\gvf chef
\gve chief
\sm 1 Personne qui est à la tête d'un groupe, d'une institution.
\ms 1
\xv Ămӑnokal n-ӑddӑwlӑt әnta a-s Emӑnnӑɣӑf n-ӑddӑwlӑt.
\xe Le Président de la République est le Chef de l'État.
\xf The President of the Republic is the Head of State.
\sy ămănokal

\lx magaẓ
\ps n
\gf gardien ; protecteur
\ge guardian; protector
\ph [magaðˤ]
\di Tawallammat T-an-Mali
\gvf gardien
\gve guardian
\sm 1 Celui qui veille sur, qui protège.
\ms 1
\xv Ǝnta a-s magaẓ n-konstitisyon.
\xe Il est le gardien de la Constitution.
\xf He is the guardian of the Constitution.
\sy ăḍḍamin

\lx tanăya
\va tanӑya
\ps n
\gf mandat
\ge mandate; term of office
\ph [tanəja]
\di Tawallammat T-an-Mali
\gvf mandat
\gve mandate
\sm 1 Durée des fonctions d'une personne élue.
\ms 1
\xv Ămӑnokal n-ӑddӑwlӑt wate n-tamәtte a t-isanӑfranӑn i-tanӑya n-sәmmos iwәtyan.
\xe Le Président de la République est élu au suffrage universel pour un mandat de cinq ans.
\xf The President of the Republic is elected by universal suffrage for a five-year term.
\sy mănda

\lx mănda
\va mӑndat
\va mӑnda
\ps n
\gf mandat ; durée de fonction
\ge mandate; term of office
\ph [mənda]
\di Tawallammat T-an-Mali
\gvf mandat
\gve mandate
\sm 1 Période pendant laquelle une personne élue exerce ses fonctions.
\ms 1
\xv A ijӑn dӑɣ wӑr-t-illa ere iddooben ad-ӑj a okӑyӑn әssin mӑndatӑn dӑɣ-tӑzirt i-ӑddӑwlӑt.
\xe En aucun cas, nul ne peut exercer plus de deux mandats consécutifs.
\xf In no case may anyone serve more than two consecutive terms.
\sy tanăya

\lx kăndida
\va kandidat
\va kӑndida
\ps n
\gf candidat
\ge candidate
\ph [kəndida]
\di Tawallammat T-an-Mali
\gvf candidat
\gve candidate
\sm 1 Personne qui se présente à une élection.
\ms 1
\xv A ӑmoos kӑndida n-tәmmәnukәkәla n-ӑddӑwlӑt, ilzam-t ad-ӑmoos U-Mali s-alӑṣӑl...
\xe Pour être candidat à la présidence de l'État, il faut être Malien d'origine...
\xf To be a candidate for the presidency of the State, one must be Malian by origin...

\lx alăṣăl
\va alăṣal
\va alӑṣӑl
\ps n
\gf origine ; souche
\ge origin; ancestry
\ph [aləsˤəl]
\di Tawallammat T-an-Mali
\gvf origine
\gve origin
\sm 1 Appartenance par la naissance à une nation, à une lignée.
\ms 1
\xv A ӑmoos kӑndida n-tәmmәnukәkәla n-ӑddӑwlӑt, ilzam-t ad-ӑmoos U-Mali s-alӑṣӑl...
\xe Pour être candidat à la présidence de l'État, il faut être Malien d'origine...
\xf To be a candidate for the presidency of the State, one must be Malian by origin...
\sy tawset

\lx išilan
\va išilăn
\ps n
\gf jours
\ge days
\ph [iʃilan]
\di Tawallammat T-an-Mali
\gvf jours
\gve days
\sm 1 Période de vingt-quatre heures.
\ms 1
\xv ...wӑr okey 60 išilan.
\xe ...ne dépassant pas 60 jours.
\xf ...not exceeding 60 days.
\an iwətyan

\lx kur
\va kor
\ps n
\gf cour (de justice)
\ge court (of justice)
\ph [kur]
\di Tawallammat T-an-Mali
\gvf cour
\gve court
\sm 1 Organe juridictionnel chargé de rendre la justice.
\ms 1
\xv ...tәddoobӑt kur konstitisyonel asәhhin n-tawӑlayt-ten...
\xe ...la cour constitutionnelle peut reporter ce tour...
\xf ...the constitutional court may postpone this round...

\lx tăẓune
\va tăẓuni
\va tӑẓune
\ps n
\gf majorité
\ge majority
\ph [təðˤune]
\di Tawallammat T-an-Mali
\gvf majorité
\gve majority
\sm 1 Le plus grand nombre de voix lors d'un vote.
\ms 1
\xv Ămӑnokal n-ӑddӑwlӑt, a okӑyӑn tӑẓune n-ӑddinӑt wi әjӑnen wӑte.
\xe Le Président de l'État est celui qui obtient la majorité des suffrages exprimés.
\xf The President of the State is the one who obtains the majority of the votes cast.

\lx tawălayt
\va tawălet
\va tawӑlayt
\ps n
\gf tour (électoral)
\ge round (electoral)
\ph [tawəlajt]
\di Tawallammat T-an-Mali
\gvf tour
\gve round
\sm 1 Chacune des phases d'une élection à plusieurs scrutins.
\ms 1
\xv Afӑl wӑr-has-dd-iɣsel a-wen, dӑɣ-tawӑlayt ta tӑzzarӑt, ad-tӑj tawӑlayt ta s-sӑnatӑt...
\xe S'il n'obtient pas cela au premier tour, il y aura un second tour...
\xf If this is not obtained in the first round, there will be a second round...

\lx ăššăk
\va əškəy
\va ӑššӑk
\ps n
\gf doute ; contestation ; plainte
\ge doubt; dispute; complaint
\ph [əʃːək]
\di Tawallammat T-an-Mali
\gvf contestation
\gve dispute
\sm 1 Action de contester la validité ou la régularité d'un acte, d'une élection.
\ms 1
\xv Asujjӑr n-sӑrho n-wӑte wa isanayӑn ӑmӑnokal n-ӑddӑwlӑt, kur konstitisyonel a dd-iqqal. Ǝnta a tažӑmmaɣӑt fӑll-әškәyyatӑn...
\xe La régularité du vote pour l'élection du président de l'État relève de la cour constitutionnelle. C'est elle qui statue sur les contestations...
\xf The regularity of the vote for the election of the president of the State is the responsibility of the constitutional court. It is the one that rules on disputes...

\lx tahuḍe
\ps n
\gf serment
\ge oath
\ph [tahuɖe]
\di Tawallammat T-an-Mali
\gvf serment
\gve oath
\sm 1 Affirmation ou promesse solennelle faite en invoquant une autorité supérieure.
\ms 1
\xv Dat-arӑmas-net i-әššәɣәl, ad-ӑj Ămӑnokal n- ӑddӑwlӑt tahuḍe-ta dat-kur konstitisyonel...
\xe Avant d'entrer en fonction, le Président de la République prête ce serment devant la Cour Constitutionnelle...
\xf Before taking office, the President of the Republic takes this oath before the Constitutional Court...

\lx măssinăɣ
\va Măssinəɣ
\va mӑssinӑɣ
\ps n.prop
\gf Dieu
\ge God
\ph [məsːinəɣ]
\di Tawallammat T-an-Mali
\gvf Dieu
\gve God
\sm 1 L'Être suprême, créateur de l'univers.
\ms 1
\xv “Ǝhaḍӑɣ, dat-Mӑssinӑɣ d-tamәtte-i-dӑɣ n-Mali tәllullet..."
\xe "Je jure, devant Dieu et le peuple malien souverain..."
\xf "I swear, before God and the sovereign Malian people..."

\lx tafləst
\va taflәst
\ps n
\gf parjure ; trahison du serment
\ge perjury; breaking of an oath
\ph [tafləst]
\di Tawallammat T-an-Mali
\gvf parjure
\gve perjury
\sm 1 Violation d'un serment.
\ms 1
\xv Afӑl әrẓeɣ erkӑwӑl-wa, tәrmәset dӑɣ-ɣ tamәtte taflәst ta hi tәjӑ, irjәšet fӑlla-ӑššӑreɣa a ija dӑɣ-tәsәmme.
\xe En cas de parjure, que je subisse les rigueurs de la loi.
\xf In case of perjury, may I suffer the rigors of the law.

\lx ekətəb
\va akătab
\va ekәtәb
\ps n
\gf écrit ; déclaration
\ge writing; declaration
\ph [ekətəb]
\di Tawallammat T-an-Mali
\gvf déclaration
\gve declaration
\sm 1 Document écrit officiel.
\ms 1
\xv ...ad-ӑkf eketәb n-a-wa ila ɣәrәd i-emӑnnӑɣӑf n- Taggayt n-imašraɣӑn ta tojjӑt tiḍḍant n-ӑlmal n-ӑddӑwlӑt...
\xe ...il remettra une déclaration écrite de tous ses biens au président de la Cour des comptes...
\xf ...he will submit a written declaration of all his assets to the president of the Court of Auditors...

\lx mizăr
\va amizăr
\va mizӑr
\ps adj
\gf premier
\ge first; prime
\ph [mizər]
\di Tawallammat T-an-Mali
\gvf premier
\gve prime
\sm 1 Qui est au premier rang, le principal.
\ms 1
\xv ...ad dd-tәqqәl tәmmәnәya-net mizӑr n-mәnistӑrӑn.
\xe ...ses pouvoirs seront exercés par le Premier ministre.
\xf ...his powers will be exercised by the Prime Minister.

\lx mənistăr
\va mәnistәr
\va mәnistӑr
\ps n
\gf ministre
\ge minister
\ph [mənistər]
\di Tawallammat T-an-Mali
\gvf ministre
\gve minister
\sm 1 Membre du gouvernement, à la tête d'un département ministériel.
\ms 1
\xv Ămӑnokal n- ӑddӑwlӑt a isanayӑn ӑmizӑr n-mәnistӑrӑn, әnta daɣ a t-izizәbbun.
\xe Le Président de la République nomme le Premier ministre, et il met fin à ses fonctions.
\xf The President of the Republic appoints the Prime Minister, and he terminates his functions.

\lx ordonănṣ
\va ordonănṣt
\va ordonӑnṣ
\ps n
\gf ordonnance
\ge ordinance
\ph [ordonənsˤ]
\di Tawallammat T-an-Mali
\gvf ordonnance
\gve ordinance
\sm 1 Acte pris par le gouvernement dans des matières qui sont normalement du domaine de la loi.
\ms 1
\xv Ămӑnokal n-ӑddӑwlӑt, әnta a iššašwalӑn ordonӑnṣtӑn d-dekretӑn...
\xe Le Président de la République signe les ordonnances et les décrets...
\xf The President of the Republic signs the ordinances and decrees...

\lx dekre
\va dekret
\ps n
\gf décret
\ge decree
\ph [dekre]
\di Tawallammat T-an-Mali
\gvf décret
\gve decree
\sm 1 Acte exécutoire à portée générale ou individuelle pris par le pouvoir exécutif.
\ms 1
\xv Ămӑnokal n-ӑddӑwlӑt, әnta a iššašwalӑn ordonӑnṣtӑn d-dekretӑn...
\xe Le Président de la République signe les ordonnances et les décrets...
\xf The President of the Republic signs the ordinances and decrees...

\lx anbăsadert
\va ambasader
\va anbӑsadert
\ps n
\gf ambassadeur
\ge ambassador
\ph [anbəsadert]
\di Tawallammat T-an-Mali
\gvf ambassadeur
\gve ambassador
\sm 1 Représentant diplomatique de rang le plus élevé d'un État auprès d'un autre.
\ms 1
\xv Ămӑnokal n- ӑddӑwlӑt, әnta a isanayӑn anbӑsadertӑn d-inәmmušal wi әskӑtnen...
\xe Le Président de la République nomme les ambassadeurs et les envoyés extraordinaires...
\xf The President of the Republic appoints the ambassadors and the extraordinary envoys...

\lx šanbăr
\va šanbərt
\va šanbӑr
\ps n
\gf chambre (parlementaire)
\ge chamber (parliamentary)
\ph [ʃanbər]
\di Tawallammat T-an-Mali
\gvf chambre
\gve chamber
\sm 1 Chacune des assemblées qui composent le parlement.
\ms 1
\xv Tәmmәnәya ta n-asәmel n- ӑššӑreɣatӑn, tәle sӑnatӑt šanbӑrtӑn: dәbәtetӑn d-Sena.
\xe Le pouvoir législatif est exercé par deux chambres : les députés et le Sénat.
\xf The legislative power is exercised by two chambers: the deputies and the Senate.

\lx kongre
\ps n
\gf congrès
\ge congress
\ph [kongre]
\di Tawallammat T-an-Mali
\gvf congrès
\gve congress
\sm 1 Réunion des deux chambres du parlement.
\ms 1
\xv Tartit n- šanbӑrtӑn tin-dӑɣ n-sӑnatӑt a-s itawӑnna Kongre.
\xe La réunion des deux chambres est appelée Congrès.
\xf The meeting of the two chambers is called Congress.

\lx sena
\ps n
\gf sénat
\ge senate
\ph [sena]
\di Tawallammat T-an-Mali
\gvf sénat
\gve senate
\sm 1 La chambre haute du parlement.
\ms 1
\xv Tәmmәnәya ta n-asәmel n- ӑššӑreɣatӑn, tәle sӑnatӑt šanbӑrtӑn: dәbәtetӑn d-Sena.
\xe Le pouvoir législatif est exercé par deux chambres : les députés et le Sénat.
\xf The legislative power is exercised by two chambers: the deputies and the Senate.

\lx senater
\ps n
\gf sénateur
\ge senator
\ph [senater]
\di Tawallammat T-an-Mali
\gvf sénateur
\gve senator
\sm 1 Membre du Sénat, la chambre haute du parlement.
\ms 1
\xv Ill’-ee ӑššӑreɣa iskatӑn, issibdӑdӑn i-ӑlhӑkӑn d-ӑttaloɣӑn wi ijarrӑw dәbәte meɣ senater.
\xe Une loi organique fixe les indemnités et les avantages du député ou du sénateur.
\xf An organic law determines the allowances and benefits of the deputy or senator.
\an dәbәtet

\lx iminite
\ps n
\gf immunité (parlementaire)
\ge immunity (parliamentary)
\ph [iminite]
\di Tawallammat T-an-Mali
\gvf immunité
\gve immunity
\sm 1 Privilège qui protège un parlementaire de poursuites judiciaires pour les actes liés à sa fonction.
\ms 1
\xv Dәbәte meɣ senater ijӑn a fӑl-t-iddiyӑt ӑššӑreɣa, ad-t-ifәl әssәṭur wa s-itawӑnna iminite...
\xe Le député ou le sénateur contre qui une action en justice est intentée, bénéficie de l'immunité...
\xf The deputy or senator against whom legal action is brought, benefits from immunity...

\lx sesyon
\ps n
\gf session (parlementaire)
\ge session (parliamentary)
\ph [sesjon]
\di Tawallammat T-an-Mali
\gvf session
\gve session
\sm 1 Période durant laquelle une assemblée parlementaire se réunit.
\ms 1
\xv Afӑl wӑdden dӑɣ-sesyontӑn, dәbәtetӑn d- kӑl-Sena, tajjӑn tӑmoqqest tәskatӑt i-a-wen-dӑɣ.
\xe En dehors des sessions, les députés et les sénateurs tiennent une réunion extraordinaire à cet effet.
\xf Outside of sessions, the deputies and senators hold an extraordinary meeting for this purpose.
\sy taɣimit

\lx komisyon
\ps n
\gf commission (parlementaire)
\ge commission (parliamentary)
\ph [komisjon]
\di Tawallammat T-an-Mali
\gvf commission
\gve commission
\sm 1 Groupe de travail composé de parlementaires, chargé d'examiner des projets de loi ou des questions spécifiques.
\ms 1
\xv Dәbәte meɣ Senater, ilzam ujәš n-timašalen n-komisyontӑn d-ižәmmiɣӑn n-taggayt ta iha.
\xe Le député ou le sénateur doit participer aux travaux des commissions et aux séances plénières de l'assemblée à laquelle il appartient.
\xf The deputy or senator must participate in the work of the commissions and plenary sessions of the assembly to which he belongs.

\lx farləma
\va farlәma
\ps n
\gf parlement
\ge parliament
\ph [farləma]
\di Tawallammat T-an-Mali
\gvf parlement
\gve parliament
\sm 1 Assemblée ou ensemble des assemblées (députés, sénateurs) qui détiennent le pouvoir législatif.
\ms 1
\xv Hak iyyӑt dӑɣ-šanbӑrtӑn n- farlәma, ad-tәkәn әššәrәḍӑn n-rӑjjoš n-rӑjjoš-net.
\xe Chacune des chambres du parlement établit son règlement intérieur.
\xf Each of the chambers of parliament establishes its own rules of procedure.

\lx brože
\ps n
\gf projet (de loi)
\ge draft (law)
\ph [broʒe]
\di Tawallammat T-an-Mali
\gvf projet
\gve draft
\sm 1 Texte de loi soumis à l'examen du parlement par le gouvernement.
\ms 1
\xv Brožetӑn n- ӑššӑreɣatӑn tinmәnnikӑn fӑlla-sӑn mәnistӑrӑn...
\xe Les projets de loi sont délibérés en conseil des ministres...
\xf Draft laws are deliberated in the council of ministers...

\lx bidže
\ps n
\gf budget
\ge budget
\ph [bidʒe]
\di Tawallammat T-an-Mali
\gvf budget
\gve budget
\sm 1 Acte par lequel sont prévues et autorisées les recettes et les dépenses annuelles de l'État.
\ms 1
\xv ...ad-ikәn ӑlxәkum bidže ӑlwӑqq-wen-dӑɣ...
\xe ...le gouvernement peut établir le budget par ordonnance...
\xf ...the government can establish the budget by ordinance...

\lx isəstan
\va isәstan
\ps n
\gf questions (au gouvernement)
\ge questions (to the government)
\ph [isəstan]
\di Tawallammat T-an-Mali
\gvf questions
\gve questions
\sm 1 Procédure parlementaire permettant aux députés d'interroger les ministres sur leur politique.
\ms 1
\xv Ǝddooben Dәbәtetӑn ad-ӑjәn isәstanӑn әktabnen i-mәnistӑrӑn...
\xe Les députés peuvent poser des questions écrites aux ministres...
\xf The deputies may ask written questions to the ministers...
\an ălwižab

\lx tixəkkam
\va tixәkkam
\ps n
\gf pouvoir judiciaire ; juridictions
\ge judicial power; courts
\ph [tixəkːam]
\di Tawallammat T-an-Mali
\gvf pouvoir judiciaire
\gve judiciary
\sm 1 Ensemble des tribunaux et des magistrats chargés de rendre la justice.
\ms 1
\xv EƔӐF V : TIXӘKKAM TI N-KӐL-ӐŠŠӐREƔA
\xe CHAPITRE V : LE POUVOIR JUDICIAIRE
\xf CHAPTER V: THE JUDICIAL POWER

\lx kur sifrem
\ps n
\gf Cour suprême
\ge Supreme Court
\ph [kur sifrem]
\di Tawallammat T-an-Mali
\gvf Cour suprême
\gve Supreme Court
\sm 1 La plus haute juridiction de l'ordre judiciaire.
\ms 1
\xv Taggayt n-imašraɣӑn ta tәššӑmӑt s-itawӑnna kur sifrem...
\xe Le pouvoir judiciaire est exercé par la Cour suprême...
\xf The judicial power is exercised by the Supreme Court...

\lx təlbinart
\va tәlbinart
\ps n
\gf tribunal
\ge tribunal
\ph [təlbinart]
\di Tawallammat T-an-Mali
\gvf tribunal
\gve tribunal
\sm 1 Juridiction chargée de juger les litiges.
\ms 1
\xv ...d-tәlbinartӑn ti hӑḍnen a dd-әqqalnӑt.
\xe ...et les autres cours et tribunaux.
\xf ...and the other courts and tribunals.
\sy kur

\lx žiž
\ps n
\gf juge
\ge judge
\ph [ʒiʒ]
\di Tawallammat T-an-Mali
\gvf juge
\gve judge
\sm 1 Magistrat chargé de rendre la justice.
\ms 1
\xv Žižtӑn, dӑɣ-timašalen-nӑsӑn, wӑr-tәdәnkun ar i- ӑššӑreɣa.
\xe Les juges, dans leurs fonctions, ne sont soumis qu'à la loi.
\xf Judges, in their duties, are subject only to the law.
\sy mažistra

\lx konsăy
\va konsӑy
\ps n
\gf conseil
\ge council
\ph [konsəj]
\di Tawallammat T-an-Mali
\gvf conseil
\gve council
\sm 1 Organe consultatif ou délibérant.
\ms 1
\xv Tәdhal-t taggayt ta s-itawӑnna konsӑy siferier n-mažistratir.
\xe Il est assisté par le Conseil Supérieur de la Magistrature.
\xf He is assisted by the Superior Council of the Magistracy.
\sy taggayt

\lx mažistra
\ps n
\gf magistrat
\ge magistrate
\ph [maʒistra]
\di Tawallammat T-an-Mali
\gvf magistrat
\gve magistrate
\sm 1 Personne appartenant au corps judiciaire, exerçant la fonction de juger ou de requérir l'application de la loi.
\ms 1
\xv Taggayt ta tәššӑmӑt n-žižtӑn, tәja әnniyӑt i-asәnnәtibәɣ n-efes n-tumast n-mažistra...
\xe Le Conseil supérieur de la magistrature veille à la gestion de la carrière des magistrats...
\xf The Superior Council of the Magistracy oversees the career management of magistrates...
\sy žiž

\lx mažistratir
\ps n
\gf magistrature
\ge magistracy
\ph [maʒistratir]
\di Tawallammat T-an-Mali
\gvf magistrature
\gve magistracy
\sm 1 Corps des magistrats.
\ms 1
\xv Tәdhal-t taggayt ta s-itawӑnna konsӑy siferier n-mažistratir.
\xe Il est assisté par le Conseil Supérieur de la Magistrature.
\xf He is assisted by the Superior Council of the Magistracy.

\lx kur de kont
\ps n
\gf Cour des comptes
\ge Court of Auditors
\ph [kur de kont]
\di Tawallammat T-an-Mali
\gvf Cour des comptes
\gve Court of Auditors
\sm 1 Juridiction chargée de contrôler les comptes publics.
\ms 1
\xv Kur de kont, әnta a-s taggayt n-imašraɣӑn ta tojӑrӑt tojjat iẓәrfan n-ӑlxәkum...
\xe La Cour des comptes est la juridiction supérieure de contrôle des finances publiques...
\xf The Court of Auditors is the superior jurisdiction for the control of public finances...

\lx inaẓrafăn
\va inaẓrafӑn
\ps n
\gf comptables publics
\ge public accountants
\ph [inazˤrafən]
\di Tawallammat T-an-Mali
\gvf comptables publics
\gve public accountants
\sm 1 Agents chargés de la tenue des comptes de l'État.
\ms 1
\xv Kur de kont, eḍanӑn n-inaẓrafӑn n-ӑddӑwlӑt a šarrӑɣ...
\xe La Cour des comptes juge les comptes des comptables publics...
\xf The Court of Auditors judges the accounts of public accountants...

\lx konsăyye
\va konsӑyye

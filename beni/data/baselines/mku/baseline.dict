\lang mku
\name seben-maninka
\ver 0.2.0

\lx a
\ps prn
\gf lui, elle, ça (forme non emphatique)
\ge him, her, it (non-emphatic form)
\ph /a/
\gvf lui, elle, ça
\gve him, her, it
\xv A fútà-tà.
\xe Il est arrivé.
\xf He arrived.

\lx aamíina
\ps intj
\gf ainsi soit-il
\ge amen, so be it
\ph /aːmíːna/
\gvf ainsi soit-il
\gve amen, so be it
\xv Amíina!
\xe Ainsi soit-il!
\xf Amen!

\lx abáríka
\ps intj
\gf merci
\ge thank you
\ph /abáríkà/
\gvf merci
\gve thank you
\xv Abáríka, í ye ŋ́ buuñaa, Ála maa díndiŋ ye í buuñaa.
\xe Merci, tu m’as honoré, Dieu fasse qu’un enfant t’honore.
\xf Thank you, you honored me, may God bless a child for you.

\lx Alaˊ
\ps n
\gf Dieu
\ge God
\ph /ala/
\gvf Dieu
\gve God
\xv Ála maa a kéla alifaabatudíŋo ti.
\xe Que Dieu en fasse un enfant qui recherche les conseils de ses aînés.
\xf May God make him a child who seeks the advice of his elders.

\lx álahadi
\ps n
\gf dimanche
\ge Sunday
\ph /álahàdi/
\gvf dimanche
\gve Sunday
\sm Jour de la semaine.
\ms 1
\xv Bíi álahadi-lum-báa ma, waasálaamu.
\xe En ce dimanche, je vous salue.
\xf On this Sunday, I greet you.

\lx álamaani
\ps v
\gf donner une amende
\ge to fine
\ph /álamaːni/
\vl tr
\gvf donner une amende
\gve to fine
\sm Infliger une pénalité financière.
\ms 1
\xv I ye álámáanoo laa ŋ́ kaŋ.
\xe Ils m’ont donné une amende.
\xf They gave me a fine.

\lx álimaami
\ps n
\gf imam
\ge imam
\ph /álimaːmi/
\gvf imam
\gve imam
\sm Chef religieux musulman.
\ms 1
\xv Alimáamoo be káŋkúláaroo la.
\xe L’imam est en train de faire une annonce.
\xf The imam is making an announcement.

\lx álu
\ps prn
\gf vous (forme non emphatique)
\ge you (plural, non-emphatic)
\ph /álu/
\gvf vous
\gve you
\xv Álu ŋ só god-óo la !
\xe Donnez-moi de l’argent !
\xf Give me money!

\lx alúŋ
\ps prn
\gf pronom inclusif
\ge inclusive pronoun
\ph /alúŋ/
\gvf nous (inclusif)
\gve us (inclusive)
\sm Pronom de la première personne du pluriel qui inclut l'interlocuteur, utilisé dans les constructions impératives inclusives.
\ms 1
\xv Alúŋ ŋe taɣa !
\xe Partons !
\xf Let's go!

\lx ambáa
\ps intj
\gf réponse des hommes à une salutation
\ge men's reply to a greeting
\ph /ambáː/
\gvf bonjour (réponse)
\gve hello (reply)
\sm Réponse traditionnelle utilisée par les hommes après une salutation.
\ms 1
\xv A: I niŋ baara! B: Ambáa!
\xe A: Bonjour! B: Bonjour!
\xf A: Hello! B: Hello!

\lx ánnabii
\ps n
\gf prophète
\ge prophet
\ph /ánnàbiː/
\gvf prophète
\gve prophet
\sm Personne qui transmet un message divin.
\ms 1
\xv Annabii Musa mu Ala la kiilaa ti.
\xe Le prophète Moïse est l'envoyé de Dieu.
\xf The prophet Moses is God's messenger.

\lx ansíi
\ps intj
\gf réponse des femmes à une salutation
\ge women's reply to a greeting
\ph /ansíː/
\gvf bonjour (réponse)
\gve hello (reply)
\sm Réponse traditionnelle utilisée par les femmes après une salutation.
\ms 1
\xv A: I niŋ baara! B: Ansíi!
\xe A: Bonjour! B: Bonjour!
\xf A: Hello! B: Hello!

\lx áraba
\ps n
\gf mercredi
\ge Wednesday
\ph /áràba/
\gvf mercredi
\gve Wednesday
\sm Jour de la semaine.
\ms 1
\xv Lúumoo ka ké jaŋ arába wó arába.
\xe Il y a marché ici tous les mercredis.
\xf There is a market here every Wednesday.

\lx árjanna
\ps n
\gf paradis
\ge paradise
\ph /árʤànna/
\gvf paradis
\gve paradise
\sm Lieu de bonheur éternel dans les religions.
\ms 1
\xv Ala ye moɣo kendemaa lu bula arjanna to.
\xe Dieu met les bonnes personnes au paradis.
\xf God puts good people in paradise.

\lx árkamisa
\ps n
\gf jeudi
\ge Thursday
\ph /árkàmisa/
\gvf jeudi
\gve Thursday
\sm Jour de la semaine.
\ms 1
\xv Tiba mee ke árkamisa-lúŋ-o.
\xe On ne couvre pas les cases le jeudi.
\xf Houses are not roofed on Thursday.

\lx áte
\ps prn
\gf lui, elle (forme emphatique)
\ge him, her (emphatic form)
\ph /áte/
\gvf lui, elle
\gve him, her
\xv Áte mu Yéraa lée ti.
\xe Je suis Yéra.
\xf I am Yéra.

\lx áwa
\ps intj
\gf d’accord !
\ge okay!
\ph /áwa/
\gvf d'accord !
\gve okay!
\sm Exclamation marquant l'accord ou l'acceptation.
\ms 1
\xv Áwa, á kǔw-o be téŋ née.
\xe Donc, c’est comme ça que ça se passe.
\xf So, that's how it happens.

\lx ayí
\ps intj
\gf non
\ge no
\ph /ayí/
\gvf non
\gve no
\sm Mot utilisé pour exprimer la négation.
\ms 1
\xv A: I be taɣa-la baa? B: Ayí, ŋ te taɣa-la.
\xe A: Tu vas partir? B: Non, je ne partirai pas.
\xf A: Are you leaving? B: No, I am not leaving.

\lx baˊ
\ps n
\gf maman
\ge mom, mother
\ph /baː/
\gvf maman
\gve mom, mother
\sm Terme affectueux pour désigner la mère.
\ms 1
\xv Ŋ bá maŋ náa nóo jáŋ.
\xe Ma mère n’a pas pu venir ici.
\xf My mother could not come here.

\lx báa
\ps n
\gf chèvre
\ge goat
\ph /báː/
\gvf chèvre
\gve goat
\sm Animal domestique ruminant, élevé pour sa viande et son lait.
\ms 1
\xv Baa la konotodiyáa lée ye a bút-ǒo búla kooma.
\xe C’est la générosité de la chèvre qui lui a mis la vulve vers l’arrière.
\xf It is the generosity of the goat that put its vulva to the back.

\lx baa
\ps part
\gf est-ce que ? (particule interrogative)
\ge is it that? (interrogative particle)
\ph /baː/
\gvf est-ce que ?
\gve is it that?
\sm Particule placée en fin de phrase pour former une question totale.
\ms 1
\xv I-te lée ye ñíŋ kin-óo tabí baa ?
\xe Est-ce que c’est toi qui a préparé ce plat ?
\xf Is it you who prepared this dish?

\lx -baa
\ps mrph
\gf grand, très, beaucoup (suffixe augmentatif)
\ge big, very, much (augmentative suffix)
\ph /-baː/
\gvf grand, très, beaucoup
\gve big, very, much
\sm Suffixe utilisé pour indiquer une grande taille, une grande quantité ou une intensité élevée.
\ms 1
\xv Tíya-báa lée sóto.
\xe Il a récolté beaucoup d’arachide.
\xf He harvested a lot of groundnuts.

\lx baabaˊ
\ps n
\gf papa
\ge dad, father
\ph /baːbaː/
\gvf papa
\gve dad, father
\sm Terme affectueux pour désigner le père.
\ms 1
\xv Ŋ baabá be balúu-riŋ née.
\xe Mon père est en vie.
\xf My father is alive.

\lx baaboloŋ
\ps n
\gf bas-fond
\ge low-lying area
\ph /baːbòloŋ/
\gvf bas-fond
\gve low-lying area
\sm Zone de terrain basse et humide, souvent inondable.
\ms 1
\xv Baaboloŋ to, jii be siyaa.
\xe Dans le bas-fond, il y a beaucoup d'eau.
\xf In the low-lying area, there is a lot of water.

\lx baabulu
\ps n
\gf affluent
\ge tributary
\ph /baːbùlu/
\gvf affluent
\gve tributary
\sm Cours d'eau qui se jette dans un autre plus grand.
\ms 1
\xv Baabulu be dun baa to.
\xe L'affluent se jette dans le fleuve.
\xf The tributary flows into the river.

\lx baadaa
\ps n
\gf bord du fleuve
\ge riverbank
\ph /baːdaː/
\gvf bord du fleuve
\gve riverbank
\sm Zone de terre le long d'un fleuve.
\ms 1
\xv Kúlúŋolu be báadaa to.
\xe Les bateaux sont au bord du fleuve.
\xf The boats are at the river's edge.

\lx baadee
\ps v
\gf enterrer
\ge to bury
\ph /baːdeː/
\vl tr
\gvf enterrer
\gve to bury
\sm Mettre un corps ou un objet sous terre.
\ms 1
\xv I máŋ furêe báadee fóloo.
\xe Ils n’ont pas encore enterré le cadavre.
\xf They have not yet buried the corpse.

\lx baadiŋ
\ps n
\gf parent
\ge relative
\ph /baːdiŋ/
\gvf parent
\gve relative
\sm Membre de la famille.
\ms 1
\xv Ŋ baadíŋ-o lée mu ñíŋ ti.
\xe C’est quelqu’un de ma famille.
\xf This is someone from my family.

\lx baadiŋyaa
\ps n
\gf parenté
\ge kinship
\ph /baːdiŋjaː/
\gvf parenté
\gve kinship
\sm Lien de famille entre individus.
\ms 1
\xv Baadiŋ-yáa sáŋ-táa měe je.
\xe La parenté ne s’achète pas.
\xf Kinship cannot be bought.


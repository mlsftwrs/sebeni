# Seynara / Supyire Senufo (spp) morphotactic patterns
# version 2026.11.23 — revised from beni/data/raw/spp.txt & test.json
# Fixes: removed Bambara/Songhay copy-paste (-kayna, -ndi, -man); fixed nonSPP so tonal vowels are NOT EMPR!

# macro definitions
macro   @v@             <re>.*[aoeuiɛɔàáâèéêìíîòóôùúû]</re>
macro   @cons@          <re>.*[bcdfghjklmɲŋprstwy]</re>
macro   @syl@           [^aoeuiɛɔ]*(?P<V>[aoeuiɛɔ])(?P=V)?

# processing instructions
plan
for token:
stage 0 add parallel parse inflection
stage 0 add parallel parse common_derivation
stage 0 apply lookup
return if parsed
stage 1 add sequential parse n_v_derivation
stage 1 add parallel parse n_derivation
stage 1 add parallel parse v_derivation
stage 1 add parallel parse num_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse nonSPP
return if parsed

# --- INFLECTION (Senufo Noun Class Suffixes & Nasal Proclitics) ---
section inflection
# Human / Animate classes: -ŋi / -ŋɔ (sg), -bi / -bii / -pi / -pyi (pl)
pattern :n/adj/prn/n.prop: [ {|ŋi}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:DEF.CL1 ]
pattern :n/adj/prn/n.prop: [ {|ŋɔ}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:DEF.CL1 ]
pattern :n/adj/prn/n.prop: [ {|bii}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:PL.CL2 ]
pattern :n/adj/prn/n.prop: [ {|bi}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:PL.CL2 ]
pattern :n/adj/prn/n.prop: [ {|pyi}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:PL.CL2 ]
pattern :n/adj/prn/n.prop: [ {|pi}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:PL.CL2 ]

# Non-human / Collective classes: -gi/-ge/-gɔ/-ki/-ke/-kɔ (sg), -yi/-yee (pl), -li/-le/-ri/-re (sg), -ni (sg), -mu/-mi (mass)
pattern :n/adj: [ {|gi}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|ge}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|gɔ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|ki}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|ke}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|kɔ}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL3 ]
pattern :n/adj: [ {|yi}:: ] | :n/adj: [ :n/adj: :mrph:PL.CL4 ]
pattern :n/adj: [ {|wi}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL ]
pattern :n/adj: [ {|li}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL5 ]
pattern :n/adj: [ {|le}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL5 ]
pattern :n/adj: [ {|ri}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL5 ]
pattern :n/adj: [ {|re}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL5 ]
pattern :n/adj: [ {|ni}:: ] | :n/adj: [ :n/adj: :mrph:DEF.CL ]
pattern :n/adj: [ {|mu}:: ] | :n/adj: [ :n/adj: :mrph:MASS.LIQ ]
pattern :n/adj: [ {|mi}:: ] | :n/adj: [ :n/adj: :mrph:MASS.LIQ ]

# Hyphenated proclitics (n-, m-, ɲ-, ŋ-)
pattern :v/n: [ {n-|}:: ] | :v/n: [ :mrph:SERIAL :v/n: ]
pattern :v/n: [ {m-|}:: ] | :v/n: [ :mrph:SERIAL :v/n: ]

# --- COMMON DERIVATION (Institutional & Legal) ---
section common_derivation
pattern :n/adj/v: [ {|gbagi}:: ] | :n: [ :n/adj/v: :mrph:INST ]
pattern :n/adj/v: [ {|gbagɔhɔ}:: ] | :n: [ :n/adj/v: :mrph:INST ]
pattern :n/adj/v: [ {|gbagbɔhɔ}:: ] | :n: [ :n/adj/v: :mrph:INST ]
pattern :n/adj/v: [ {|gbɔhɔ}:: ] | :n: [ :n/adj/v: :mrph:INST ]
pattern :n/adj/v: [ {|bile}:: ] | :n: [ :n/adj/v: :mrph:ART.LAW ]
pattern :n/adj/v: [ {|ɲungɔ}:: ] | :n: [ :n/adj/v: :mrph:DIV ]

# --- RELATIONAL CLITICS ---
section n_v_derivation
pattern :n/n.prop: [ {|maa}:: ] | :n/n.prop: [ :n/n.prop: :mrph:DAT ]
pattern :n/n.prop: [ {|cɛ}:: ] | :n/n.prop: [ :n/n.prop: :mrph:BEN ]

# --- NOMINAL DERIVATION ---
section n_derivation
# Agent / Owner (-feebi, -fɛɛ, -foowi, -fo, -kɔn, -nyɔ)
pattern :n: [ {|feebi}:: ] | :n: [ :v/n: :mrph:AG.PL ]
pattern :n: [ {|fɛɛ}:: ] | :n: [ :v/n: :mrph:AG.PL ]
pattern :n: [ {|foowi}:: ] | :n: [ :v/n: :mrph:OWNER.SG ]
pattern :n: [ {|kɔn}:: ] | :n: [ :v/n: :mrph:AG ]
pattern :n: [ {|nyɔ}:: ] | :n: [ :v/n: :mrph:AG ]

# --- VERBAL DERIVATION ---
section v_derivation
# Verbal noun / resultative / suffixal extensions
pattern :v: [ {|gɛ}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :n: [ {|nki}:: ] | :n: [ :v: :mrph:NMLZ ]

# --- NUMERAL DERIVATION ---
section num_derivation
pattern :num: [ {|wi}:: ] | :num: [ :num: :mrph:DISTR ]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :v: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :v: [ :v: :: :v: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :n: [ :n: :: :n: ]

# --- POS COMPOSITION ---
section pos_composition
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n/v: :n: ] | :n: [ :n/v: :n: ]
pattern :n/v: [ :n: :v: ] | :n/v: [ :n: :v: ]
pattern :n: [ :n: :adj/num: ] | :n: [ :n: :adj/num: ]
pattern :n: [ :pp: :n: ] | :n: [ :pp: :n: ]
pattern :n: [ :n: :adj/pp/num: :n: ] | :n: [ :n: :adj/pp/num: :n: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]

# --- NON-SUPYIRE FILTER (STAGE 4 = EMPR) ---
section nonSPP
# Allows tonal vowels (à á â è é ê ì í î ò ó ô ù ú û), ʼ, ɔ, ɛ, ɲ, ŋ and homoglyphs (ͻ, ԑ)
pattern <re>.*[qxQXɓɗƴçäëïöüøðþ].*</re>:: | ::EMPR

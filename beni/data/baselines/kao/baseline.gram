# Kassonke (Xaasongaxango, kao) morphotactic patterns
# version 2026.11.23 — revised from beni/data/raw/kao.txt & test.json
# Fixes: removed broken nonkassonke consonant-final & French-digraph false positives (was 48% false EMPR!)

# macro definitions
macro   @vow@            <re>.*[aeiou]</re>
macro   @nasal-v@        <re>.*[aeiou][nŋ]</re>
macro   @nonnasal-v@     <re>.*[aeiou]</re>
macro   @cons@           <re>.*[bcdfghjklmnɲŋprstwxy]</re>
macro   @syl@            [^aeiou]*(?P<V>[aeiou])(?P=V)?([^aeiou]+(?=([^aeiou]|$)))?

# processing instructions
plan
for token:
stage 0 add parallel parse noun_inflection
stage 0 add parallel parse verb_inflection
stage 0 apply lookup
return if parsed
stage 1 add sequential parse verbal_derivation
stage 1 add parallel parse nominal_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse nonkassonke
return if parsed

# --- NOUN INFLECTION (Definiteness & Plurality) ---
section noun_inflection
# Plural suffixes (-lu, -nu)
pattern :n/adj/prn/n.prop: [ {|lu}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:PL ]
pattern :n/adj/prn/n.prop: [ {|nu}:: ] | :n/adj/prn/n.prop: [ :n/adj/prn/n.prop: :mrph:PL ]

# Definite suffixes (-o, -yo, -wo, -no, -ŋo, hyphenated -o)
pattern :n/adj/n.prop: [ {|yo}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF ]
pattern :n/adj/n.prop: [ {|wo}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF ]
pattern :n/adj/n.prop: [ {|no}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF ]
pattern :n/adj/n.prop: [ {|ŋo}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF ]
pattern :n/adj/n.prop: [ {|-o}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF ]
pattern :n/adj/n.prop: [ {<re>.*[^o]</re>|o}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF ]

# Combined Definite Plural (-olu, -yolu, -wolu, -nolu, -ŋolu)
pattern :n/adj/n.prop: [ {|olu}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF :mrph:PL ]
pattern :n/adj/n.prop: [ {|yolu}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF :mrph:PL ]
pattern :n/adj/n.prop: [ {|wolu}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF :mrph:PL ]
pattern :n/adj/n.prop: [ {|nolu}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF :mrph:PL ]
pattern :n/adj/n.prop: [ {|ŋolu}:: ] | :n/adj/n.prop: [ :n/adj/n.prop: :mrph:DEF :mrph:PL ]

# --- VERBAL INFLECTION (Aspect & Tense) ---
section verb_inflection
# Past / Accomplished (-ta, -nta, hyphenated -ta)
pattern :v: [ {|ta}:: ] | :v: [ :v: :mrph:PFV ]
pattern :v: [ {|nta}:: ] | :v: [ :v: :mrph:PFV ]
pattern :v: [ {|-ta}:: ] | :v: [ :v: :mrph:PFV ]
# Imperfective / Infinitive (-la, -ra, -na, -lo)
pattern :v: [ {|la}:: ] | :v: [ :v: :mrph:IPFV ]
pattern :v: [ {|ra}:: ] | :v: [ :v: :mrph:IPFV ]
pattern :v: [ {|na}:: ] | :v: [ :v: :mrph:IPFV ]
pattern :v: [ {|-la}:: ] | :v: [ :v: :mrph:IPFV ]
# Resultative participle (-nin, -riŋ)
pattern :v/ptcp: [ {|nin}:: ] | :ptcp: [ :v: :mrph:PTCP.RES ]
# Nominalization (-li, -lo, -ni)
pattern :n: [ {|li}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :n: [ {|lo}:: ] | :n: [ :v: :mrph:NMLZ ]

# --- VERBAL DERIVATION (Prefixes) ---
section verbal_derivation
# Causative (la-), Medial/Super (ma-), Iterative (to-)
pattern :v: [ {la|}:: ] | :v: [ :mrph:CAUS :v: ]
pattern :v: [ {ma|}:: ] | :v: [ :mrph:MID.INTNS :v: ]
pattern :v: [ {to|}:: ] | :v: [ :mrph:ITER :v: ]

# --- NOMINAL DERIVATION ---
section nominal_derivation
# Augmentative (-ba, -bo), Diminutive (-ndin, -ndingo)
pattern :n/adj: [ {|ba}:: ] | :n/adj: [ :n/adj: :mrph:AUGM ]
pattern :n/adj: [ {|ndin}:: ] | :n/adj: [ :n/adj: :mrph:DIM ]
pattern :n/adj: [ {|ndinŋo}:: ] | :n/adj: [ :n/adj: :mrph:DIM :mrph:DEF ]
# Gentilic (-ŋga, -nka)
pattern :n/n.prop: [ {|ŋga}:: ] | :n: [ :n/n.prop: :mrph:GENT ]
pattern :n/n.prop: [ {|nka}:: ] | :n: [ :n/n.prop: :mrph:GENT ]
# Abstract (-ya, -yaa)
pattern :n/adj: [ {|ya}:: ] | :n: [ :n/adj: :mrph:ABSTR ]
pattern :n/adj: [ {|yaa}:: ] | :n: [ :n/adj: :mrph:ABSTR ]
# Locative (-xola, -la, -nda)
pattern :n: [ {|xola}:: ] | :n: [ :n: :mrph:LOC ]
pattern :n/n.prop: [ {|nda}:: ] | :n: [ :n/n.prop: :mrph:LOC ]
# Privative (-ntan, -ntanŋo, -bali)
pattern :adj/n: [ {|ntan}:: ] | :adj/n: [ :n: :mrph:PRIV ]
pattern :adj/n: [ {|ntanŋo}:: ] | :adj/n: [ :n: :mrph:PRIV :mrph:DEF ]
pattern :v/ptcp: [ {|bali}:: ] | :ptcp: [ :v: :mrph:PTCP.PRIV ]
# Experient / Relational (-nte, -din)
pattern :n/adj: [ {|nte}:: ] | :n/adj: [ :n/v: :mrph:REL ]
# Agentive (-baxa, -baxo, -la, -to)
pattern :n: [ {|baxa}:: ] | :n: [ :v: :mrph:AG.OCC ]
pattern :n: [ {|baxo}:: ] | :n: [ :v: :mrph:AG.OCC :mrph:DEF ]
pattern :n: [ {|la}:: ] | :n: [ :v: :mrph:AG ]
pattern :n: [ {|to}:: ] | :n: [ :n/v: :mrph:CONV ]
# Qualifying / Instrumental (-ma, -ran)
pattern :adj/n: [ {|ma}:: ] | :adj/n: [ :n: :mrph:QUAL ]
pattern :n: [ {|ran}:: ] | :n: [ :v: :mrph:INSTR ]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :n: [ :n: :n: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :num: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :num: [ :num: :num: ]
pattern :v: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :v: [ :v: :: :v: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :n: [ :n: :: :n: ]

# --- POS COMPOSITION ---
section pos_composition
pattern :n: [ :n: :n: ] | :n: [ :n: :n: ]
pattern :n: [ :n: :adj: ] | :n: [ :n: :adj: ]
pattern :n: [ :v: :n: ] | :n: [ :v: :n: ]
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n: :v: :mrph:AG ] | :n: [ :n: :v: :mrph:AG ]
pattern :n: [ :v: :mrph:NMLZ :n: ] | :n: [ :v: :mrph:NMLZ :n: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]

# --- NON-KASSONKE FILTER (STAGE 4 = EMPR) ---
section nonkassonke
# Only filter characters outside the Kassonke alphabet (q, v, z, French accents ç/ê/î/ô/û/ù/è or non-Manding ɓɗƴƔ)
# Note: Kassonke allows final -n/-ŋ and 'x' (e.g. Xaasongaxango, baxo) and vowel sequences in compounds.
pattern <re>.*[qvzQVZɓɗƴƔƎʐʑʂʈɖçêîôûùè].*</re>:: | ::EMPR

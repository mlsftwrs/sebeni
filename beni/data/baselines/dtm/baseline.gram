# Dogon (Toro So / Tomo Kan, dtm) morphotactic patterns
# version 2026.11.23 — revised from beni/data/raw/dtm.txt & test.json
# Note: unconstrained single-letter suffixes (-i, -a, -u, -l, -r, -y, -t, -g, -m, -n)
# removed to eliminate stage 0/1 phantom splits on unparsed stems.

# macro definitions
macro   @vow@            <re>.*[aeiouɛɔ]</re>
macro   @cons@           <re>.*[bcɗfghjklmnɲŋprstwyz]</re>
macro   @syl@            [^aeiouɛɔ]*(?P<V>[aeiouɛɔ])(?P=V)?([^aeiouɛɔ]+(?=([^aeiouɛɔ]|$)))?

# processing instructions
plan
for token:
stage 0 add parallel parse noun_inflection
stage 0 add parallel parse verb_inflection
stage 0 apply lookup
return if parsed
stage 1 add sequential parse verbal_derivation
stage 1 add parallel parse nominal_derivation
stage 1 apply lookup
return if parsed
stage 2 add parallel parse reduplication
stage 2 apply lookup
return if parsed
stage 3 add parallel decompose pos_composition
stage 3 apply lookup
return if parsed
stage 4 apply firstmatch parse nondogon
return if parsed

# --- NOUN INFLECTION (Plural & Definite Enclitics) ---
section noun_inflection
# Plural suffixes attested in dtm.txt & test.json:
# -nw / -w (inɛnw, inɛw), -be / -mbe (human plural: gɔbe, bɛrɛbe, paŋabe, yagabe), -ge (inanimate plural)
pattern :n/adj/prn: [ {|nw}:: ] | :n/adj/prn: [ :n/adj/prn: :mrph:PL ]
pattern :n/adj/prn: [ {@vow@|w}:: ] | :n/adj/prn: [ :n/adj/prn: :mrph:PL ]
pattern :n/adj/prn: [ {|be}:: ] | :n/adj/prn: [ :n/adj/prn: :mrph:PL.HUM ]
pattern :n/adj/prn: [ {|mbe}:: ] | :n/adj/prn: [ :n/adj/prn: :mrph:PL.HUM ]
pattern :n/adj: [ {|ge}:: ] | :n/adj: [ :n/adj: :mrph:PL.INAN ]

# Definite / determiner enclitics (-gɔ, -gɔbe, -nɛ)
pattern :n: [ {|gɔ}:: ] | :n: [ :n: :mrph:DEF ]
pattern :n: [ {|gɔbe}:: ] | :n: [ :n: :mrph:DEF.PL ]

# --- VERBAL INFLECTION (TAM & Subject Agreement) ---
section verb_inflection
# Attested Dogon verbal suffixes:
# -jɛ PROG/IPFV (dɛnɛjɛ), -bɛin / -bɛ IPFV, -lɔ / -lu / -le NEG (dɛnɛɛlɔn)
# -dɔ / -ndɔ FUT/HAB, -nɛ PFV/REL, -ɲu / -nyu PFV.3PL, -aa PFV, -wi / -wo
pattern :v: [ {|jɛ}:: ] | :v: [ :v: :mrph:PROG ]
pattern :v: [ {|bɛin}:: ] | :v: [ :v: :mrph:IPFV ]
pattern :v: [ {|lɔ}:: ] | :v: [ :v: :mrph:NEG ]
pattern :v: [ {|lɔn}:: ] | :v: [ :v: :mrph:NEG ]
pattern :v: [ {|lu}:: ] | :v: [ :v: :mrph:PFV.NEG ]
pattern :v: [ {|le}:: ] | :v: [ :v: :mrph:IPFV.NEG ]
pattern :v: [ {|dɔ}:: ] | :v: [ :v: :mrph:FUT ]
pattern :v: [ {|ndɔ}:: ] | :v: [ :v: :mrph:FUT ]
pattern :v: [ {|nɛ}:: ] | :v: [ :v: :mrph:PFV ]
pattern :v: [ {|ɲu}:: ] | :v: [ :v: :mrph:PFV.3PL ]
pattern :v: [ {|aa}:: ] | :v: [ :v: :mrph:PFV.ALT ]

# --- VERBAL DERIVATION (Extensions) ---
section verbal_derivation
# -mɔ CAUS, -rɛ INST, -yɛ MPASS, -tɛ REVR
pattern :v: [ {|mɔ}:: ] | :v: [ :v: :mrph:CAUS ]
pattern :v: [ {|rɛ}:: ] | :v: [ :v: :mrph:INST ]
pattern :v: [ {|yɛ}:: ] | :v: [ :v: :mrph:MPASS ]
pattern :v: [ {|tɛ}:: ] | :v: [ :v: :mrph:REVR ]

# --- NOMINAL DERIVATION ---
section nominal_derivation
# -ya ABSTR, -nɛ AG/NMLZ, -kɔ / -gɔ GENT
pattern :n/adj: [ {|ya}:: ] | :n: [ :n/adj: :mrph:ABSTR ]
pattern :n: [ {|nɛ}:: ] | :n: [ :v: :mrph:NMLZ ]
pattern :n: [ {|nɔ}:: ] | :n: [ :v: :mrph:AG.SG ]

# --- REDUPLICATION ---
section reduplication
pattern :v: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :v: [ :v: :v: ]
pattern :adj: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :adj: [ :adj: :adj: ]
pattern :n: [ {<re>(?P<stem>.+)</re>|<re>(?P=stem)</re>}:: ] | :n: [ :n: :n: ]
pattern :adv: [ {<re>(?P<stem>.+)</re>|-|<re>(?P=stem)</re>}:: ] | :adv: [ :adv: :: :adv: ]

# --- POS COMPOSITION ---
section pos_composition
pattern :n: [ :n: :n: ] | :n: [ :n: :n: ]
pattern :n: [ :n: :adj: ] | :n: [ :n: :adj: ]
pattern :n: [ :v: :n: ] | :n: [ :v: :n: ]
pattern :n: [ :n: :v: ] | :n: [ :n: :v: ]
pattern :n: [ :n.prop: :n: ] | :n: [ :n.prop: :n: ]
pattern :n: [ :n: :n: :n: ] | :n: [ :n: :n: :n: ]

# --- NON-DOGON FILTER (STAGE 4 = EMPR; 'wax' -> stage 4) ---
section nondogon
# Filter non-Dogon orthographic characters (q, x, v, z are foreign to Dogon; keeps ε/ԑ/ɔ/ͻ homoglyphs)
pattern <re>.*[qxvzQXVZ].*</re>:: | ::EMPR
